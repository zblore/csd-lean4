namespace CSD.RecordLayer

/-! ### The coupled flow in the coordinates of a carrier -/

section Indexed

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {N : ℕ} (e : ι ≃ Fin (N + 1))
  {f : ℝ → ℝ} {A₀ B₀ : Matrix ι ι ℂ}

/-- **The carrier's Hamiltonian at pointer angle `φ = θ₂`**, in the carrier's own index:
`A₀ + f(φ) B₀`. -/
noncomputable def idxCoupledH (A₀ B₀ : Matrix ι ι ℂ) (hf : Function.Periodic f 1)
    (φ : AddCircle (1 : ℝ)) : Matrix ι ι ℂ :=
  A₀ + ((hf.lift φ : ℝ) : ℂ) • B₀

omit [Fintype ι] [DecidableEq ι] in
/-- The carrier's Hamiltonian is Hermitian. -/
theorem idxCoupledH_isHermitian (hA : A₀.IsHermitian) (hB : B₀.IsHermitian)
    (hf : Function.Periodic f 1) (φ : AddCircle (1 : ℝ)) :
    (idxCoupledH A₀ B₀ hf φ).IsHermitian :=
  hA.add (hB.smul (isSelfAdjoint_iff.2 (by rw [Complex.star_def, Complex.conj_ofReal])))

omit [Fintype ι] [DecidableEq ι] in
/-- The state-dependent matrix of the coupled flow of a reindexed pair is the reindexed carrier
Hamiltonian. -/
theorem coupledMatrix_reindex (A₀ B₀ : Matrix ι ι ℂ) (hf : Function.Periodic f 1)
    (φ : AddCircle (1 : ℝ)) :
    coupledMatrix (Matrix.reindex e e A₀) (Matrix.reindex e e B₀) hf φ
      = Matrix.reindex e e (idxCoupledH A₀ B₀ hf φ) :=
  rfl

omit [Fintype ι] [DecidableEq ι] in
/-- The coupled generator `−i (A₀ + f(φ) B₀)` is skew-Hermitian. -/
theorem idxCoupledGen_skew (hA : A₀.IsHermitian) (hB : B₀.IsHermitian)
    (hf : Function.Periodic f 1) (φ : AddCircle (1 : ℝ)) :
    ((-Complex.I) • idxCoupledH A₀ B₀ hf φ)ᴴ = -((-Complex.I) • idxCoupledH A₀ B₀ hf φ) := by
  rw [Matrix.conjTranspose_smul, (idxCoupledH_isHermitian hA hB hf φ).eq]
  simp

omit [Fintype ι] [DecidableEq ι] in
/-- The uncoupled generator `−i A₀` is skew-Hermitian. -/
theorem idxFreeGen_skew (hA : A₀.IsHermitian) :
    ((-Complex.I) • A₀)ᴴ = -((-Complex.I) • A₀) := by
  rw [Matrix.conjTranspose_smul, hA.eq]
  simp

/-- **The carrier's propagator** `exp (−i t (A₀ + f(φ) B₀))` on the fibre `θ₂ = φ`. -/
noncomputable def idxCarrierU (hA : A₀.IsHermitian) (hB : B₀.IsHermitian)
    (hf : Function.Periodic f 1) (φ : AddCircle (1 : ℝ)) (t : ℝ) : Matrix.unitaryGroup ι ℂ :=
  flowU (idxCoupledGen_skew hA hB hf φ) t

/-- **The uncoupled carrier's propagator** `exp (−i t A₀)`. -/
noncomputable def idxFreeU (hA : A₀.IsHermitian) (t : ℝ) : Matrix.unitaryGroup ι ℂ :=
  flowU (idxFreeGen_skew hA) t

/-- The carrier's propagator as a matrix exponential. -/
theorem idxCarrierU_val (hA : A₀.IsHermitian) (hB : B₀.IsHermitian) (hf : Function.Periodic f 1)
    (φ : AddCircle (1 : ℝ)) (t : ℝ) :
    (idxCarrierU hA hB hf φ t).val = exp (t • ((-Complex.I) • idxCoupledH A₀ B₀ hf φ)) :=
  rfl

/-- The uncoupled propagator as a matrix exponential. -/
theorem idxFreeU_val (hA : A₀.IsHermitian) (t : ℝ) :
    (idxFreeU hA t).val = exp (t • ((-Complex.I) • A₀)) :=
  rfl

/-- **The carrier's equation**: `U̇(t) = −i (A₀ + f(θ₂) B₀) U(t)`. -/
theorem hasDerivAt_idxCarrierU (hA : A₀.IsHermitian) (hB : B₀.IsHermitian)
    (hf : Function.Periodic f 1) (φ : AddCircle (1 : ℝ)) (t : ℝ) :
    HasDerivAt (fun s : ℝ => (idxCarrierU hA hB hf φ s).val)
      (((-Complex.I) • idxCoupledH A₀ B₀ hf φ) * (idxCarrierU hA hB hf φ t).val) t :=
  hasDerivAt_exp_smul_const' ((-Complex.I) • idxCoupledH A₀ B₀ hf φ) t

/-- The carrier's propagator is continuous in the flow parameter. -/
theorem continuous_idxCarrierU (hA : A₀.IsHermitian) (hB : B₀.IsHermitian)
    (hf : Function.Periodic f 1) (φ : AddCircle (1 : ℝ)) :
    Continuous fun t : ℝ => idxCarrierU hA hB hf φ t := by
  refine continuous_induced_rng.2 ?_
  exact continuous_iff_continuousAt.2 fun t => (hasDerivAt_idxCarrierU hA hB hf φ t).continuousAt

/-- The uncoupled propagator is continuous in the flow parameter. -/
theorem continuous_idxFreeU (hA : A₀.IsHermitian) : Continuous fun t : ℝ => idxFreeU hA t := by
  refine continuous_induced_rng.2 ?_
  exact continuous_iff_continuousAt.2 fun t =>
    (hasDerivAt_exp_smul_const' ((-Complex.I) • A₀) t).continuousAt

/-- On a fibre where the profile vanishes the carrier does not see the pointer. -/
theorem idxCarrierU_of_lift_eq_zero (hA : A₀.IsHermitian) (hB : B₀.IsHermitian)
    (hf : Function.Periodic f 1) {φ : AddCircle (1 : ℝ)} (h : hf.lift φ = 0) (t : ℝ) :
    idxCarrierU hA hB hf φ t = idxFreeU hA t := by
  apply Subtype.ext
  rw [idxCarrierU_val, idxFreeU_val, idxCoupledH, h, Complex.ofReal_zero, zero_smul, add_zero]

/-- The reindexed carrier propagator is the Schrödinger unitary of the coupled matrix. -/
theorem idxUnitary_idxCarrierU (hA : A₀.IsHermitian) (hB : B₀.IsHermitian)
    (hf : Function.Periodic f 1) (φ : AddCircle (1 : ℝ)) (t : ℝ) :
    idxUnitary e (idxCarrierU hA hB hf φ t)
      = Matrix.schrodingerUnitary
          (coupledMatrix_isHermitian (hA.reindex e) (hB.reindex e) hf φ) t := by
  apply Subtype.ext
  rw [idxUnitary_val, idxCarrierU_val]
  show _ = exp (Matrix.schrodingerGen
    (coupledMatrix (Matrix.reindex e e A₀) (Matrix.reindex e e B₀) hf φ) t)
  rw [reindex_exp_smul, Matrix.schrodingerGen_eq_real_smul, coupledMatrix_reindex]
  congr 2

/-- The transported carrier orbit is the Schrödinger orbit of the coupled matrix. -/
theorem idxArenaEquiv_kick (hA : A₀.IsHermitian) (hB : B₀.IsHermitian)
    (hf : Function.Periodic f 1) (φ : AddCircle (1 : ℝ)) (t : ℝ) (p : GenArena ι) :
    idxArenaEquiv e (arenaKick (idxCarrierU hA hB hf φ t) p)
      = Matrix.schrodingerUnitary
          (coupledMatrix_isHermitian (hA.reindex e) (hB.reindex e) hf φ) t
        • (idxArenaEquiv e p : CPN (N + 1)) := by
  rw [← idxUnitary_idxCarrierU, ← arenaKick_eq_smul']
  exact (arenaKick_reindex e _ p).symm

omit [DecidableEq ι] in
/-- The energy function of a reindexed matrix is `−2` times the carrier's expectation. -/
theorem schrodingerHamiltonian_reindex (C : Matrix ι ι ℂ) (p : GenArena ι) :
    schrodingerHamiltonian (Matrix.reindex e e C) (idxArenaEquiv e p) = -2 * arenaObs C p := by
  rw [schrodingerHamiltonian, expectation_eq_arenaObs]
  exact congrArg (fun r : ℝ => -2 * r) (arenaObs_reindex e _ p)

omit [DecidableEq ι] in
/-- **The coupled energy of a reindexed pair**, read on the carrier:
`−2⟨A₀⟩_p − 2 f(θ₂) ⟨B₀⟩_p`. -/
theorem coupledEnergy_reindex (A₀ B₀ : Matrix ι ι ℂ) (hf : Function.Periodic f 1)
    (p : GenArena ι) (θ : KTorus) :
    coupledEnergy (Matrix.reindex e e A₀) (Matrix.reindex e e B₀) hf (idxArenaEquiv e p, θ)
      = -2 * arenaObs A₀ p - 2 * hf.lift θ.2 * arenaObs B₀ p := by
  rw [coupledEnergy, schrodingerHamiltonian_reindex, schrodingerHamiltonian_reindex]
  show _ + _ * hf.lift θ.2 = _
  ring

/-- **The pointer's lifted displacement**: `−2 f'(φ) ∫₀ᵗ ⟨B₀⟩` along the carrier's orbit. -/
noncomputable def idxPointerShift (hA : A₀.IsHermitian) (hB : B₀.IsHermitian)
    (hf : Function.Periodic f 1) (φ : AddCircle (1 : ℝ)) (p : GenArena ι) (t : ℝ) : ℝ :=
  -2 * hf.deriv_periodic.lift φ
    * ∫ s in (0 : ℝ)..t, arenaObs B₀ (arenaKick (idxCarrierU hA hB hf φ s) p)

/-- The pointer starts at its initial angle. -/
theorem idxPointerShift_zero (hA : A₀.IsHermitian) (hB : B₀.IsHermitian)
    (hf : Function.Periodic f 1) (φ : AddCircle (1 : ℝ)) (p : GenArena ι) :
    idxPointerShift hA hB hf φ p 0 = 0 := by
  rw [idxPointerShift, intervalIntegral.integral_same, mul_zero]

/-- The accumulated `−2⟨B⟩` of the coupled flow, read on the carrier. -/
theorem coupledAccum_reindex (hA : A₀.IsHermitian) (hB : B₀.IsHermitian)
    (hf : Function.Periodic f 1) (φ : AddCircle (1 : ℝ)) (p : GenArena ι) (t : ℝ) :
    coupledAccum (hA.reindex e) (hB.reindex e) hf φ (idxArenaEquiv e p) t
      = -2 * ∫ s in (0 : ℝ)..t, arenaObs B₀ (arenaKick (idxCarrierU hA hB hf φ s) p) := by
  unfold coupledAccum
  rw [← intervalIntegral.integral_const_mul]
  refine intervalIntegral.integral_congr fun s _ => ?_
  show schrodingerHamiltonian (Matrix.reindex e e B₀)
      (Matrix.schrodingerUnitary _ s • (idxArenaEquiv e p : CPN (N + 1)))
    = -2 * arenaObs B₀ (arenaKick (idxCarrierU hA hB hf φ s) p)
  rw [← idxArenaEquiv_kick e hA hB hf φ s p, schrodingerHamiltonian_reindex]

/-- The displacement of the coupled flow, read on the carrier. -/
theorem idxPointerShift_eq (hA : A₀.IsHermitian) (hB : B₀.IsHermitian)
    (hf : Function.Periodic f 1) (φ : AddCircle (1 : ℝ)) (p : GenArena ι) (t : ℝ) :
    hf.deriv_periodic.lift φ
        * coupledAccum (hA.reindex e) (hB.reindex e) hf φ (idxArenaEquiv e p) t
      = idxPointerShift hA hB hf φ p t := by
  rw [coupledAccum_reindex e hA hB hf φ p t, idxPointerShift]
  ring

/-- **The pointer's equation**: `θ̇₁ = −2 f'(θ₂) ⟨B₀⟩` at the carrier's current state. -/
theorem hasDerivAt_idxPointerShift (hA : A₀.IsHermitian) (hB : B₀.IsHermitian)
    (hf : Function.Periodic f 1) (φ : AddCircle (1 : ℝ)) (p : GenArena ι) (t : ℝ) :
    HasDerivAt (fun s => idxPointerShift hA hB hf φ p s)
      (-2 * hf.deriv_periodic.lift φ
        * arenaObs B₀ (arenaKick (idxCarrierU hA hB hf φ t) p)) t := by
  have hcont : Continuous fun s => arenaObs B₀ (arenaKick (idxCarrierU hA hB hf φ s) p) :=
    (continuous_arenaObs B₀).comp ((continuous_idxCarrierU hA hB hf φ).arenaKick continuous_const)
  unfold idxPointerShift
  exact (intervalIntegral.integral_hasDerivAt_right (hcont.intervalIntegrable 0 t)
    (hcont.stronglyMeasurableAtFilter _ _) hcont.continuousAt).const_mul _

/-- ★★ **The Hamiltonian flow of a coupled energy, in the carrier's coordinates.** The flow of
`−2⟨A₀⟩ − 2 f(θ₂) ⟨B₀⟩` moves the carrier by `exp (−i t (A₀ + f(θ₂) B₀))`, advances `θ₁` by
`−2 f'(θ₂) ∫₀ᵗ ⟨B₀⟩` along that orbit, and fixes `θ₂`. -/
theorem hamiltonianFlow_coupledEnergy_reindex (hA : A₀.IsHermitian) (hB : B₀.IsHermitian)
    (hf : Function.Periodic f 1) (hc : ContDiff ℝ ∞ f) (t : ℝ) (p : GenArena ι) (θ : KTorus) :
    (arenaForm_isSymplectic N).hamiltonianFlow
        (contMDiff_coupledEnergy (Matrix.reindex e e A₀) (Matrix.reindex e e B₀) hf hc) t
        (idxArenaEquiv e p, θ)
      = (idxArenaEquiv e (arenaKick (idxCarrierU hA hB hf θ.2 t) p),
          (θ.1 + ((idxPointerShift hA hB hf θ.2 p t : ℝ) : AddCircle (1 : ℝ)), θ.2)) := by
  rw [hamiltonianFlow_coupledEnergy (hA.reindex e) (hB.reindex e) hf hc, idxArenaEquiv_kick,
    idxPointerShift_eq]

/-- On a fibre where the profile vanishes the displacement is the uncoupled carrier's. -/
theorem idxPointerShift_of_lift_eq_zero (hA : A₀.IsHermitian) (hB : B₀.IsHermitian)
    (hf : Function.Periodic f 1) {φ : AddCircle (1 : ℝ)} (h : hf.lift φ = 0) (p : GenArena ι)
    (t : ℝ) :
    idxPointerShift hA hB hf φ p t
      = -2 * hf.deriv_periodic.lift φ
        * ∫ s in (0 : ℝ)..t, arenaObs B₀ (arenaKick (idxFreeU hA s) p) := by
  rw [idxPointerShift]
  congr 2
  funext s
  rw [idxCarrierU_of_lift_eq_zero hA hB hf h]

/-! ### Control: a pointer coupled to the identity reads the flow parameter -/

/-- The identity has expectation `1` at every ray. -/
theorem arenaObs_one (p : GenArena ι) : arenaObs (1 : Matrix ι ι ℂ) p = 1 := by
  induction p using Projectivization.ind with
  | h v hv =>
    have h1 : Matrix.toEuclideanLin (1 : Matrix ι ι ℂ) v = v := by
      ext i
      rw [toEuclideanLin_coord, Matrix.one_mulVec]
    have hn : ‖v‖ ^ 2 ≠ 0 := pow_ne_zero 2 (norm_ne_zero_iff.2 hv)
    have hre : (inner ℂ v v).re = ‖v‖ ^ 2 := inner_self_eq_norm_sq (𝕜 := ℂ) v
    rw [arenaObs_mk_eq_inner _ hv, h1, hre, div_self hn]

/-- **Control.** A pointer coupled to the identity advances uniformly at the rate `−2 f'(θ₂)`,
whatever the carrier and whatever its state: it reads the flow parameter, not the carrier. -/
theorem idxPointerShift_one (hA : A₀.IsHermitian) (hf : Function.Periodic f 1)
    (φ : AddCircle (1 : ℝ)) (p : GenArena ι) (t : ℝ) :
    idxPointerShift hA (Matrix.isHermitian_one : (1 : Matrix ι ι ℂ).IsHermitian) hf φ p t
      = -2 * hf.deriv_periodic.lift φ * t := by
  rw [idxPointerShift]
  simp only [arenaObs_one]
  rw [intervalIntegral.integral_const, sub_zero, smul_eq_mul, mul_one]

/-! ### The comparison with the uncoupled carrier -/

section Bound

variable [Nonempty ι]

/-- ★ **The coupled carrier stays within `|t| |f(θ₂)| ‖B₀‖` of the uncoupled one**, in operator
norm: the Duhamel bound for the static term `f(θ₂) B₀`. -/
theorem norm_idxCarrierU_sub_le (hA : A₀.IsHermitian) (hB : B₀.IsHermitian)
    (hf : Function.Periodic f 1) (φ : AddCircle (1 : ℝ)) (t : ℝ) :
    ‖(idxCarrierU hA hB hf φ t).val - (idxFreeU hA t).val‖ ≤ |t| * (|hf.lift φ| * ‖B₀‖) := by
  rw [idxCarrierU_val, idxFreeU_val]
  refine (Matrix.norm_exp_smul_neg_I_sub_le _ _ (idxCoupledH_isHermitian hA hB hf φ) hA t).trans ?_
  refine mul_le_mul_of_nonneg_left (le_of_eq ?_) (abs_nonneg t)
  have hd : idxCoupledH A₀ B₀ hf φ - A₀ = ((hf.lift φ : ℝ) : ℂ) • B₀ := by
    rw [idxCoupledH, add_sub_cancel_left]
  rw [hd, norm_smul, Complex.norm_real, Real.norm_eq_abs]

/-- ★ **An observable read along the coupled orbit** is within `2 ‖C‖ |s| |f(θ₂)| ‖B₀‖` of its
value along the uncoupled orbit. -/
theorem abs_arenaObs_idxCarrierU_sub_le (hA : A₀.IsHermitian) (hB : B₀.IsHermitian)
    (hf : Function.Periodic f 1) (φ : AddCircle (1 : ℝ)) (C : Matrix ι ι ℂ) (p : GenArena ι)
    (s : ℝ) :
    |arenaObs C (arenaKick (idxCarrierU hA hB hf φ s) p)
        - arenaObs C (arenaKick (idxFreeU hA s) p)|
      ≤ 2 * ‖C‖ * (|s| * (|hf.lift φ| * ‖B₀‖)) :=
  (abs_arenaObs_arenaKick_sub_le _ _ C p).trans
    (mul_le_mul_of_nonneg_left (norm_idxCarrierU_sub_le hA hB hf φ s) (by positivity))

/-- ★ **The accumulated observable** is within `‖C‖ |f(θ₂)| ‖B₀‖ t²` of the uncoupled one. -/
theorem abs_integral_arenaObs_idxCarrierU_sub_le (hA : A₀.IsHermitian) (hB : B₀.IsHermitian)
    (hf : Function.Periodic f 1) (φ : AddCircle (1 : ℝ)) (C : Matrix ι ι ℂ) (p : GenArena ι)
    {t : ℝ} (ht : 0 ≤ t) :
    |(∫ s in (0 : ℝ)..t, arenaObs C (arenaKick (idxCarrierU hA hB hf φ s) p))
        - ∫ s in (0 : ℝ)..t, arenaObs C (arenaKick (idxFreeU hA s) p)|
      ≤ ‖C‖ * (|hf.lift φ| * ‖B₀‖) * t ^ 2 := by
  have hU : Continuous fun s => arenaObs C (arenaKick (idxCarrierU hA hB hf φ s) p) :=
    (continuous_arenaObs C).comp ((continuous_idxCarrierU hA hB hf φ).arenaKick continuous_const)
  have hV : Continuous fun s => arenaObs C (arenaKick (idxFreeU hA s) p) :=
    (continuous_arenaObs C).comp ((continuous_idxFreeU hA).arenaKick continuous_const)
  rw [← intervalIntegral.integral_sub (hU.intervalIntegrable 0 t) (hV.intervalIntegrable 0 t)]
  have hc : Continuous fun s : ℝ => 2 * ‖C‖ * (s * (|hf.lift φ| * ‖B₀‖)) := by fun_prop
  refine (intervalIntegral.abs_integral_le_integral_abs ht).trans ?_
  refine (intervalIntegral.integral_mono_on ht ((hU.sub hV).abs.intervalIntegrable 0 t)
    (hc.intervalIntegrable 0 t) fun s hs => ?_).trans_eq ?_
  · have h := abs_arenaObs_idxCarrierU_sub_le hA hB hf φ C p s
    rwa [abs_of_nonneg hs.1] at h
  · rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_mul_const, integral_id]
    ring

/-- ★★ **The displacement along the coupled carrier**, on every fibre: within
`2 |f'(θ₂)| |f(θ₂)| ‖B₀‖² t²` of the displacement along the uncoupled carrier. The error is the
price of the static term the carrier sees. -/
theorem abs_idxPointerShift_sub_le (hA : A₀.IsHermitian) (hB : B₀.IsHermitian)
    (hf : Function.Periodic f 1) (φ : AddCircle (1 : ℝ)) (p : GenArena ι) {t : ℝ} (ht : 0 ≤ t) :
    |idxPointerShift hA hB hf φ p t
        - -2 * hf.deriv_periodic.lift φ
          * ∫ s in (0 : ℝ)..t, arenaObs B₀ (arenaKick (idxFreeU hA s) p)|
      ≤ 2 * |hf.deriv_periodic.lift φ| * (‖B₀‖ * (|hf.lift φ| * ‖B₀‖) * t ^ 2) := by
  rw [idxPointerShift, ← mul_sub, abs_mul, abs_mul, abs_neg, abs_two]
  exact mul_le_mul_of_nonneg_left
    (abs_integral_arenaObs_idxCarrierU_sub_le hA hB hf φ B₀ p ht) (by positivity)

end Bound

end Indexed

/-! ### The level-swap quadrature -/

section Swap

variable (n : Type*) [DecidableEq n]

/-- **The level swap** `1 ⊗ σ_x` on a system with a two-level internal degree of freedom: it
exchanges the two levels and leaves everything else alone. Its expectation is the real quadrature
of the coherence between the levels. -/
def levelSwap : Matrix (n × Fin 2) (n × Fin 2) ℂ :=
  Matrix.of fun x y => if x.1 = y.1 ∧ x.2 ≠ y.2 then 1 else 0

/-- The level swap is Hermitian. -/
theorem levelSwap_isHermitian : (levelSwap n).IsHermitian := by
  refine Matrix.IsHermitian.ext fun x y => ?_
  simp only [levelSwap, Matrix.of_apply]
  split_ifs with h1 h2 h2
  · exact star_one _
  · exact absurd ⟨h1.1.symm, Ne.symm h1.2⟩ h2
  · exact absurd ⟨h2.1.symm, Ne.symm h2.2⟩ h1
  · exact star_zero _

variable {n} [Fintype n]

/-- The level swap moves the upper level's amplitude to the lower level. -/
theorem levelSwap_mulVec_zero (Ψ : n × Fin 2 → ℂ) (p : n) :
    (levelSwap n *ᵥ Ψ) (p, 0) = Ψ (p, 1) := by
  simp [Matrix.mulVec, dotProduct, levelSwap, Fintype.sum_prod_type, Fin.sum_univ_two]

/-- The level swap moves the lower level's amplitude to the upper level. -/
theorem levelSwap_mulVec_one (Ψ : n × Fin 2 → ℂ) (p : n) :
    (levelSwap n *ᵥ Ψ) (p, 1) = Ψ (p, 0) := by
  simp [Matrix.mulVec, dotProduct, levelSwap, Fintype.sum_prod_type, Fin.sum_univ_two]

/-- The level swap is an involution. -/
theorem levelSwap_mul_self : levelSwap n * levelSwap n = 1 := by
  ext ⟨p, i⟩ ⟨q, j⟩
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, levelSwap, Fintype.sum_prod_type, Fin.sum_univ_two, Matrix.one_apply]

/-- The level swap has operator norm at most `1`. -/
theorem norm_levelSwap_le [Nonempty n] : ‖levelSwap n‖ ≤ 1 := by
  have hmem : levelSwap n ∈ Matrix.unitaryGroup (n × Fin 2) ℂ := by
    rw [Matrix.mem_unitaryGroup_iff, Matrix.star_eq_conjTranspose, (levelSwap_isHermitian n).eq,
      levelSwap_mul_self]
  exact (CStarRing.norm_of_mem_unitary hmem).le

/-- ★ **The reading of the level swap at a ray**: twice the real part of the coherence between the
two levels, over the squared norm. -/
theorem arenaObs_levelSwap_mk {v : EuclideanSpace ℂ (n × Fin 2)} (hv : v ≠ 0) :
    arenaObs (levelSwap n) (Projectivization.mk ℂ v hv)
      = 2 * (∑ p, star (v (p, 0)) * v (p, 1)).re / ‖v‖ ^ 2 := by
  rw [arenaObs_mk_eq_inner]
  congr 1
  rw [PiLp.inner_apply, Fintype.sum_prod_type, Complex.re_sum, Complex.re_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl fun p _ => ?_
  rw [Fin.sum_univ_two, toEuclideanLin_coord, toEuclideanLin_coord, levelSwap_mulVec_zero,
    levelSwap_mulVec_one]
  simp only [RCLike.inner_apply, Complex.star_def, Complex.add_re, Complex.mul_re,
    Complex.conj_re, Complex.conj_im]
  ring

/-- The reading after a kick, in the kicked vector's coordinates. -/
theorem arenaObs_levelSwap_kick_mk (U : Matrix.unitaryGroup (n × Fin 2) ℂ)
    {v : EuclideanSpace ℂ (n × Fin 2)} (hv : v ≠ 0) :
    arenaObs (levelSwap n) (arenaKick U (Projectivization.mk ℂ v hv))
      = 2 * (∑ p, star ((U.val *ᵥ fun j => v j) (p, 0)) * (U.val *ᵥ fun j => v j) (p, 1)).re
        / ‖v‖ ^ 2 := by
  have hU : (U.val)ᴴ * U.val = 1 := by
    have hmem := U.property
    rwa [Matrix.mem_unitaryGroup_iff', Matrix.star_eq_conjTranspose] at hmem
  rw [arenaKick_mk _ hv, arenaObs_levelSwap_mk, Matrix.norm_toEuclideanLin_of_isom hU v]
  simp only [toEuclideanLin_coord]

end Swap

/-! ### The clock in the joint energy -/

/-- The device's Hamiltonian is Hermitian. -/
theorem deviceHam_isHermitian {L : ℕ} (J μ₀ μ₁ : ℝ) :
    (deviceHam (L := L) J μ₀ μ₁).IsHermitian := by
  rw [Matrix.IsHermitian, deviceHam, Matrix.blockDiagonal_conjTranspose]
  congr 1
  funext i
  exact diracHam_isHermitian J _

section Clock

variable {M : ℕ}

/-- **The index bridge**: `((site, component), level)` of the two-level device on the ring of
`M + 1` sites as the index `Fin (4M + 4)` of the projective sector of `Σ`. -/
def clockIdx (M : ℕ) : (ZMod (M + 1) × Fin 2) × Fin 2 ≃ Fin (4 * M + 3 + 1) :=
  ((diracIdx M).prodCongr (Equiv.refl (Fin 2))).trans
    ((finProdFinEquiv (m := 2 * M + 1 + 1) (n := 2)).trans (finCongr (by omega)))

/-- The device's arena `ℙ(ℂ^{(ring × 2) × 2})` as the projective sector `ℂℙ^{4M+3}` of `Σ`. -/
noncomputable def clockArenaEquiv (M : ℕ) :
    GenArena ((ZMod (M + 1) × Fin 2) × Fin 2) ≃ CPN (4 * M + 3 + 1) :=
  idxArenaEquiv (clockIdx M)

variable (M) in
/-- The level swap scaled by the coupling `g`: what the pointer is coupled to. -/
noncomputable def clockB (g : ℝ) :
    Matrix ((ZMod (M + 1) × Fin 2) × Fin 2) ((ZMod (M + 1) × Fin 2) × Fin 2) ℂ :=
  (g : ℂ) • levelSwap (ZMod (M + 1) × Fin 2)

/-- The coupled operator is Hermitian. -/
theorem clockB_isHermitian (g : ℝ) : (clockB M g).IsHermitian := by
  unfold clockB
  exact (levelSwap_isHermitian _).smul
    (isSelfAdjoint_iff.2 (by rw [Complex.star_def, Complex.conj_ofReal]))

/-- The coupled operator has norm at most `|g|`. -/
theorem norm_clockB_le (g : ℝ) : ‖clockB M g‖ ≤ |g| := by
  rw [clockB, norm_smul, Complex.norm_real, Real.norm_eq_abs]
  exact mul_le_of_le_one_right (abs_nonneg _) norm_levelSwap_le

variable {f : ℝ → ℝ} (J μ₀ μ₁ g : ℝ) (hf : Function.Periodic f 1)

variable (M) in
/-- ★ **The joint energy of the two-level device and the pointer on `Σ`**:
`−2⟨H_dev⟩ − 2 g f(θ₂) ⟨X⟩`, `X` the level swap. -/
noncomputable def clockPointerEnergy : KSigma (4 * M + 3 + 1) → ℝ :=
  coupledEnergy (Matrix.reindex (clockIdx M) (clockIdx M) (deviceHam J μ₀ μ₁))
    (Matrix.reindex (clockIdx M) (clockIdx M) (clockB M g)) hf

/-- The joint energy is smooth for a smooth profile. -/
theorem contMDiff_clockPointerEnergy (hc : ContDiff ℝ ∞ f) :
    ContMDiff 𝓘(ℝ, ArenaModel (4 * M + 3)) 𝓘(ℝ, ℝ) ∞ (clockPointerEnergy M J μ₀ μ₁ g hf) :=
  contMDiff_coupledEnergy _ _ hf hc

/-- ★★ **The energy is `−2⟨H_dev⟩_p − 2 g f(θ₂) ⟨X⟩_p`**, read on the device's arena. -/
theorem clockPointerEnergy_eq (p : GenArena ((ZMod (M + 1) × Fin 2) × Fin 2)) (θ : KTorus) :
    clockPointerEnergy M J μ₀ μ₁ g hf (clockArenaEquiv M p, θ)
      = -2 * arenaObs (deviceHam J μ₀ μ₁) p
        - 2 * g * hf.lift θ.2 * arenaObs (levelSwap (ZMod (M + 1) × Fin 2)) p := by
  have h : arenaObs (clockB M g) p = g * arenaObs (levelSwap (ZMod (M + 1) × Fin 2)) p :=
    arenaObs_real_smul g (levelSwap (ZMod (M + 1) × Fin 2)) p
  have h2 := coupledEnergy_reindex (clockIdx M) (deviceHam J μ₀ μ₁) (clockB M g) hf p θ
  rw [h] at h2
  rw [show clockPointerEnergy M J μ₀ μ₁ g hf (clockArenaEquiv M p, θ)
    = coupledEnergy (Matrix.reindex (clockIdx M) (clockIdx M) (deviceHam J μ₀ μ₁))
      (Matrix.reindex (clockIdx M) (clockIdx M) (clockB M g)) hf
      (idxArenaEquiv (clockIdx M) p, θ) from rfl, h2]
  ring

/-- The device's Hamiltonian on the fibre `θ₂ = φ`: `H_dev + g f(φ) X`. -/
theorem idxCoupledH_clock (φ : AddCircle (1 : ℝ)) :
    idxCoupledH (deviceHam (L := M + 1) J μ₀ μ₁) (clockB M g) hf φ
      = deviceHam J μ₀ μ₁ + ((g * hf.lift φ : ℝ) : ℂ) • levelSwap (ZMod (M + 1) × Fin 2) := by
  rw [idxCoupledH, clockB, smul_smul, ← Complex.ofReal_mul, mul_comm (hf.lift φ) g]

variable (M) in
/-- **The device's propagator on the fibre `θ₂ = φ`**: `exp (−i t (H_dev + g f(φ) X))`. -/
noncomputable def clockCarrierU (φ : AddCircle (1 : ℝ)) (t : ℝ) :
    Matrix.unitaryGroup ((ZMod (M + 1) × Fin 2) × Fin 2) ℂ :=
  idxCarrierU (deviceHam_isHermitian J μ₀ μ₁) (clockB_isHermitian g) hf φ t

/-- The propagator as a matrix exponential. -/
theorem clockCarrierU_val (φ : AddCircle (1 : ℝ)) (t : ℝ) :
    (clockCarrierU M J μ₀ μ₁ g hf φ t).val
      = exp (t • ((-Complex.I) • (deviceHam J μ₀ μ₁
          + ((g * hf.lift φ : ℝ) : ℂ) • levelSwap (ZMod (M + 1) × Fin 2)))) := by
  rw [clockCarrierU, idxCarrierU_val, idxCoupledH_clock]

/-- ★★ **The device's equation**: `U̇(t) = −i (H_dev + g f(θ₂) X) U(t)`. The two levels are
mixed by the pointer's static term; with it off the equation is the device's own. -/
theorem hasDerivAt_clockCarrierU (φ : AddCircle (1 : ℝ)) (t : ℝ) :
    HasDerivAt (fun s : ℝ => (clockCarrierU M J μ₀ μ₁ g hf φ s).val)
      (((-Complex.I) • (deviceHam J μ₀ μ₁
          + ((g * hf.lift φ : ℝ) : ℂ) • levelSwap (ZMod (M + 1) × Fin 2)))
        * (clockCarrierU M J μ₀ μ₁ g hf φ t).val) t := by
  have h := hasDerivAt_idxCarrierU (deviceHam_isHermitian (L := M + 1) J μ₀ μ₁)
    (clockB_isHermitian g) hf φ t
  rw [idxCoupledH_clock] at h
  exact h

/-- **The reading along the device's orbit** on the fibre `θ₂ = φ`: the expectation of the level
swap at the device's current state. It is the coefficient of the pointer's equation. -/
noncomputable def clockRead (φ : AddCircle (1 : ℝ))
    (p : GenArena ((ZMod (M + 1) × Fin 2) × Fin 2)) (s : ℝ) : ℝ :=
  arenaObs (levelSwap (ZMod (M + 1) × Fin 2)) (arenaKick (clockCarrierU M J μ₀ μ₁ g hf φ s) p)

/-- The reading is continuous in the flow parameter. -/
theorem continuous_clockRead (φ : AddCircle (1 : ℝ))
    (p : GenArena ((ZMod (M + 1) × Fin 2) × Fin 2)) :
    Continuous fun s => clockRead J μ₀ μ₁ g hf φ p s := by
  unfold clockRead clockCarrierU
  exact (continuous_arenaObs _).comp
    ((continuous_idxCarrierU _ _ hf φ).arenaKick continuous_const)

/-- The coupled operator read along the orbit is `g` times the reading. -/
theorem arenaObs_clockB (φ : AddCircle (1 : ℝ))
    (p : GenArena ((ZMod (M + 1) × Fin 2) × Fin 2)) (s : ℝ) :
    arenaObs (clockB M g) (arenaKick (clockCarrierU M J μ₀ μ₁ g hf φ s) p)
      = g * clockRead J μ₀ μ₁ g hf φ p s :=
  arenaObs_real_smul g (levelSwap (ZMod (M + 1) × Fin 2))
    (arenaKick (clockCarrierU M J μ₀ μ₁ g hf φ s) p)

/-- **The pointer's lifted displacement**: `−2 g f'(φ) ∫₀ᵗ ⟨X⟩` along the device's orbit. -/
noncomputable def clockPointerShift (φ : AddCircle (1 : ℝ))
    (p : GenArena ((ZMod (M + 1) × Fin 2) × Fin 2)) (t : ℝ) : ℝ :=
  -(2 * g) * hf.deriv_periodic.lift φ * ∫ s in (0 : ℝ)..t, clockRead J μ₀ μ₁ g hf φ p s

/-- The pointer starts at rest at its initial angle. -/
theorem clockPointerShift_zero (φ : AddCircle (1 : ℝ))
    (p : GenArena ((ZMod (M + 1) × Fin 2) × Fin 2)) :
    clockPointerShift J μ₀ μ₁ g hf φ p 0 = 0 := by
  rw [clockPointerShift, intervalIntegral.integral_same, mul_zero]

/-- Control: with the coupling off the pointer does not respond. -/
theorem clockPointerShift_zero_coupling (φ : AddCircle (1 : ℝ))
    (p : GenArena ((ZMod (M + 1) × Fin 2) × Fin 2)) (t : ℝ) :
    clockPointerShift J μ₀ μ₁ 0 hf φ p t = 0 := by
  rw [clockPointerShift, mul_zero, neg_zero, zero_mul, zero_mul]

/-- The displacement of the generic coupled flow, for the clock's two operators. -/
theorem idxPointerShift_clock (φ : AddCircle (1 : ℝ))
    (p : GenArena ((ZMod (M + 1) × Fin 2) × Fin 2)) (t : ℝ) :
    idxPointerShift (deviceHam_isHermitian J μ₀ μ₁) (clockB_isHermitian g) hf φ p t
      = clockPointerShift J μ₀ μ₁ g hf φ p t := by
  have h : ∀ s, arenaObs (clockB M g)
      (arenaKick (idxCarrierU (deviceHam_isHermitian J μ₀ μ₁) (clockB_isHermitian g) hf φ s) p)
      = g * clockRead J μ₀ μ₁ g hf φ p s := fun s => arenaObs_clockB J μ₀ μ₁ g hf φ p s
  rw [idxPointerShift, clockPointerShift]
  simp only [h]
  rw [intervalIntegral.integral_const_mul]
  ring

/-- ★★ **The pointer's equation**: `θ̇₁ = −2 g f'(θ₂) ⟨X⟩_{p(t)}`, the level-swap quadrature at the
device's current state. -/
theorem hasDerivAt_clockPointerShift (φ : AddCircle (1 : ℝ))
    (p : GenArena ((ZMod (M + 1) × Fin 2) × Fin 2)) (t : ℝ) :
    HasDerivAt (fun s => clockPointerShift J μ₀ μ₁ g hf φ p s)
      (-(2 * g) * hf.deriv_periodic.lift φ * clockRead J μ₀ μ₁ g hf φ p t) t := by
  have hcont := continuous_clockRead J μ₀ μ₁ g hf φ p
  unfold clockPointerShift
  exact (intervalIntegral.integral_hasDerivAt_right (hcont.intervalIntegrable 0 t)
    (hcont.stronglyMeasurableAtFilter _ _) hcont.continuousAt).const_mul _

/-! ### The Hamiltonian flow -/

variable (M) in
/-- ★ **The joint dynamics of the device and the pointer**: the Hamiltonian flow of
`clockPointerEnergy` for the arena symplectic form. -/
noncomputable def clockPointerFlow (hc : ContDiff ℝ ∞ f) (t : ℝ) :
    KSigma (4 * M + 3 + 1) → KSigma (4 * M + 3 + 1) :=
  (arenaForm_isSymplectic (4 * M + 3)).hamiltonianFlow
    (contMDiff_clockPointerEnergy J μ₀ μ₁ g hf hc) t

/-- The flow at parameter zero is the identity. -/
theorem clockPointerFlow_zero (hc : ContDiff ℝ ∞ f) (x : KSigma (4 * M + 3 + 1)) :
    clockPointerFlow M J μ₀ μ₁ g hf hc 0 x = x :=
  integralFlow_zero ((arenaForm_isSymplectic (4 * M + 3)).contMDiff_hamiltonianVectorField_tangent
    (contMDiff_clockPointerEnergy J μ₀ μ₁ g hf hc)) x

/-- The flow is a one-parameter group. -/
theorem clockPointerFlow_add (hc : ContDiff ℝ ∞ f) (s t : ℝ) (x : KSigma (4 * M + 3 + 1)) :
    clockPointerFlow M J μ₀ μ₁ g hf hc (s + t) x
      = clockPointerFlow M J μ₀ μ₁ g hf hc s (clockPointerFlow M J μ₀ μ₁ g hf hc t x) :=
  integralFlow_add ((arenaForm_isSymplectic (4 * M + 3)).contMDiff_hamiltonianVectorField_tangent
    (contMDiff_clockPointerEnergy J μ₀ μ₁ g hf hc)) s t x

/-- ★★★ **The device and the pointer, solved.** The Hamiltonian flow of
`−2⟨H_dev⟩ − 2 g f(θ₂) ⟨X⟩` moves the device by `exp (−i t (H_dev + g f(θ₂) X))`, advances `θ₁` by
`−2 g f'(θ₂) ∫₀ᵗ ⟨X⟩` along that orbit, and fixes `θ₂`. -/
theorem clockPointerFlow_apply (hc : ContDiff ℝ ∞ f) (t : ℝ)
    (p : GenArena ((ZMod (M + 1) × Fin 2) × Fin 2)) (θ : KTorus) :
    clockPointerFlow M J μ₀ μ₁ g hf hc t (clockArenaEquiv M p, θ)
      = (clockArenaEquiv M (arenaKick (clockCarrierU M J μ₀ μ₁ g hf θ.2 t) p),
          (θ.1 + ((clockPointerShift J μ₀ μ₁ g hf θ.2 p t : ℝ) : AddCircle (1 : ℝ)), θ.2)) := by
  rw [← idxPointerShift_clock]
  exact hamiltonianFlow_coupledEnergy_reindex (clockIdx M) (deviceHam_isHermitian J μ₀ μ₁)
    (clockB_isHermitian g) hf hc t p θ

/-- The angle `θ₂` is conserved. -/
theorem clockPointerFlow_snd_snd (hc : ContDiff ℝ ∞ f) (t : ℝ) (x : KSigma (4 * M + 3 + 1)) :
    (clockPointerFlow M J μ₀ μ₁ g hf hc t x).2.2 = x.2.2 := by
  obtain ⟨y, θ⟩ := x
  obtain ⟨p, rfl⟩ := (clockArenaEquiv M).surjective y
  rw [clockPointerFlow_apply]

/-- ★★ **Liouville**: the joint flow preserves the arena volume. -/
theorem arenaVolume_map_clockPointerFlow (hc : ContDiff ℝ ∞ f) (t : ℝ) :
    Measure.map (clockPointerFlow M J μ₀ μ₁ g hf hc t) (arenaVolume (4 * M + 3))
      = arenaVolume (4 * M + 3) :=
  arenaVolume_map_hamiltonianFlow (contMDiff_clockPointerEnergy J μ₀ μ₁ g hf hc) t

/-- **Liouville for the corpus's `μ_FS ⊗ vol_{T²}`.** -/
theorem kMuL_map_clockPointerFlow (hc : ContDiff ℝ ∞ f) (p₀ : CPN (4 * M + 3 + 1)) (t : ℝ) :
    Measure.map (clockPointerFlow M J μ₀ μ₁ g hf hc t) (kMuL p₀) = kMuL p₀ :=
  kMuL_map_hamiltonianFlow (4 * M + 3) p₀ (contMDiff_clockPointerEnergy J μ₀ μ₁ g hf hc) t

end Clock

/-! ### The ideal hand -/

section Hand

/-- **The ideal quadrature**: the real part of a coherence `C₀` turning at the rate `R`,
`Re (e^{−iRs} C₀)`. -/
noncomputable def clockQuad (R : ℝ) (C₀ : ℂ) (s : ℝ) : ℝ :=
  C₀.re * Real.cos (R * s) + C₀.im * Real.sin (R * s)

/-- The quadrature is the real part of the turning coherence. -/
theorem re_exp_mul_eq_clockQuad (R : ℝ) (C₀ : ℂ) (s : ℝ) :
    (Complex.exp (Complex.I * (((-R : ℝ) : ℂ) * s)) * C₀).re = clockQuad R C₀ s := by
  have h : Complex.I * (((-R : ℝ) : ℂ) * s) = ((-(R * s) : ℝ) : ℂ) * Complex.I := by
    push_cast
    ring
  rw [h, Complex.mul_re, Complex.exp_ofReal_mul_I_re, Complex.exp_ofReal_mul_I_im, Real.cos_neg,
    Real.sin_neg, clockQuad]
  ring

/-- The quadrature as an amplitude times a cosine: `‖C₀‖ cos (R s − arg C₀)`. -/
theorem clockQuad_eq_norm_mul_cos (R : ℝ) (C₀ : ℂ) (s : ℝ) :
    clockQuad R C₀ s = ‖C₀‖ * Real.cos (R * s - Complex.arg C₀) := by
  have hre := Complex.norm_mul_cos_arg C₀
  have him := Complex.norm_mul_sin_arg C₀
  rw [clockQuad, Real.cos_sub, ← hre, ← him]
  ring

/-- The quadrature is continuous. -/
theorem continuous_clockQuad (R : ℝ) (C₀ : ℂ) : Continuous fun s => clockQuad R C₀ s := by
  unfold clockQuad
  fun_prop

/-- The quadrature is at most the coherence's modulus. -/
theorem abs_clockQuad_le (R : ℝ) (C₀ : ℂ) (s : ℝ) : |clockQuad R C₀ s| ≤ ‖C₀‖ := by
  rw [clockQuad_eq_norm_mul_cos, abs_mul, abs_of_nonneg (norm_nonneg _)]
  exact mul_le_of_le_one_right (norm_nonneg _) (Real.abs_cos_le_one _)

/-- ★ **Where the quadrature vanishes**: at the flow times with `R s − arg C₀` an odd multiple of
`π/2`, so half a turn of the coherence apart. -/
theorem clockQuad_eq_zero_iff (R : ℝ) {C₀ : ℂ} (hC : C₀ ≠ 0) (s : ℝ) :
    clockQuad R C₀ s = 0 ↔ ∃ k : ℤ, R * s - Complex.arg C₀ = (2 * k + 1) * Real.pi / 2 := by
  rw [clockQuad_eq_norm_mul_cos, mul_eq_zero, Real.cos_eq_zero_iff]
  exact or_iff_right (norm_ne_zero_iff.mpr hC)

/-- **The ideal hand**: the accumulated quadrature `∫₀ᵗ Re (e^{−iRs} C₀) ds`, in closed form. -/
noncomputable def clockHand (R : ℝ) (C₀ : ℂ) (t : ℝ) : ℝ :=
  (C₀.re * Real.sin (R * t) + C₀.im * (1 - Real.cos (R * t))) / R

/-- The hand starts at zero. -/
theorem clockHand_zero (R : ℝ) (C₀ : ℂ) : clockHand R C₀ 0 = 0 := by
  simp [clockHand]

/-- The hand's rate is the quadrature. -/
theorem hasDerivAt_clockHand {R : ℝ} (hR : R ≠ 0) (C₀ : ℂ) (s : ℝ) :
    HasDerivAt (fun x => clockHand R C₀ x) (clockQuad R C₀ s) s := by
  have hlin : HasDerivAt (fun x : ℝ => R * x) R s := by
    simpa using (hasDerivAt_id s).const_mul R
  have hsin := (Real.hasDerivAt_sin (R * s)).comp s hlin
  have hcos := (Real.hasDerivAt_cos (R * s)).comp s hlin
  have h := ((hsin.const_mul C₀.re).add ((hcos.const_sub 1).const_mul C₀.im)).div_const R
  unfold clockHand
  refine h.congr_deriv ?_
  rw [clockQuad, div_eq_iff hR]
  ring

/-- ★ **The accumulated quadrature is the hand.** -/
theorem integral_clockQuad {R : ℝ} (hR : R ≠ 0) (C₀ : ℂ) (t : ℝ) :
    ∫ s in (0 : ℝ)..t, clockQuad R C₀ s = clockHand R C₀ t := by
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun s _ => hasDerivAt_clockHand hR C₀ s)
    ((continuous_clockQuad R C₀).intervalIntegrable 0 t), clockHand_zero, sub_zero]

/-- ★ **The hand returns**: it has the period `2π/R` of the coherence. -/
theorem clockHand_add_period {R : ℝ} (hR : R ≠ 0) (C₀ : ℂ) (t : ℝ) :
    clockHand R C₀ (t + 2 * Real.pi / R) = clockHand R C₀ t := by
  have h : R * (t + 2 * Real.pi / R) = R * t + 2 * Real.pi := by
    field_simp
  simp only [clockHand, h, Real.sin_add_two_pi, Real.cos_add_two_pi]

/-- ★ **The hand is bounded**: it never leaves `2 ‖C₀‖ / |R|`. It is a hand that swings, not a
counter that accumulates. -/
theorem abs_clockHand_le (R : ℝ) (C₀ : ℂ) (t : ℝ) : |clockHand R C₀ t| ≤ 2 * ‖C₀‖ / |R| := by
  have hnum : C₀.re * Real.sin (R * t) + C₀.im * (1 - Real.cos (R * t))
      = ‖C₀‖ * (Real.sin (R * t - Complex.arg C₀) + Real.sin (Complex.arg C₀)) := by
    have hre := Complex.norm_mul_cos_arg C₀
    have him := Complex.norm_mul_sin_arg C₀
    rw [Real.sin_sub, ← hre, ← him]
    ring
  have hs : |Real.sin (R * t - Complex.arg C₀) + Real.sin (Complex.arg C₀)| ≤ 2 := by
    refine (abs_add_le _ _).trans ?_
    linarith [Real.abs_sin_le_one (R * t - Complex.arg C₀),
      Real.abs_sin_le_one (Complex.arg C₀)]
  rw [clockHand, hnum, abs_div, abs_mul, abs_of_nonneg (norm_nonneg _), mul_comm 2]
  gcongr

end Hand

/-! ### The clock law -/

section Law

variable {M : ℕ}

/-- **The ray of a device amplitude** in the device's projective space. -/
noncomputable def deviceRay (Ψ : (ZMod (M + 1) × Fin 2) × Fin 2 → ℂ) (hΨ : Ψ ≠ 0) :
    GenArena ((ZMod (M + 1) × Fin 2) × Fin 2) :=
  Projectivization.mk ℂ (WithLp.toLp 2 Ψ) (by simpa using hΨ)

/-- The squared norm of a device amplitude is its `deviceNorm`. -/
theorem norm_sq_toLp_device (Ψ : (ZMod (M + 1) × Fin 2) × Fin 2 → ℂ) :
    ‖(WithLp.toLp 2 Ψ : EuclideanSpace ℂ ((ZMod (M + 1) × Fin 2) × Fin 2))‖ ^ 2
      = (deviceNorm Ψ).re := by
  rw [EuclideanSpace.norm_sq_eq, deviceNorm, Complex.re_sum]
  refine Finset.sum_congr rfl fun x _ => ?_
  rw [Complex.star_def, Complex.conj_mul']
  norm_cast

/-- A nonzero device amplitude has positive norm. -/
theorem deviceNorm_re_pos {Ψ : (ZMod (M + 1) × Fin 2) × Fin 2 → ℂ} (hΨ : Ψ ≠ 0) :
    0 < (deviceNorm Ψ).re := by
  rw [← norm_sq_toLp_device]
  have h : (WithLp.toLp 2 Ψ : EuclideanSpace ℂ ((ZMod (M + 1) × Fin 2) × Fin 2)) ≠ 0 := by
    simpa using hΨ
  exact pow_pos (norm_pos_iff.mpr h) 2

/-- ★ **The uncoupled carrier is the device's own propagator** `deviceProp`: the object the
free-chain clock theorems are about. -/
theorem idxFreeU_deviceHam_val (J μ₀ μ₁ s : ℝ) :
    (idxFreeU (deviceHam_isHermitian (L := M + 1) J μ₀ μ₁) s).val = deviceProp J μ₀ μ₁ s := by
  rw [idxFreeU_val, deviceProp]
  congr 1
  ext a b
  simp only [Matrix.smul_apply, Complex.real_smul, smul_eq_mul]
  ring

/-- **The reading along the device's uncoupled orbit**: the level swap read at the state moved
by `deviceProp`. -/
noncomputable def clockFreeRead (J μ₀ μ₁ : ℝ)
    (p : GenArena ((ZMod (M + 1) × Fin 2) × Fin 2)) (s : ℝ) : ℝ :=
  arenaObs (levelSwap (ZMod (M + 1) × Fin 2))
    (arenaKick (idxFreeU (deviceHam_isHermitian J μ₀ μ₁) s) p)

/-- The uncoupled reading is continuous in the flow parameter. -/
theorem continuous_clockFreeRead (J μ₀ μ₁ : ℝ)
    (p : GenArena ((ZMod (M + 1) × Fin 2) × Fin 2)) :
    Continuous fun s => clockFreeRead J μ₀ μ₁ p s := by
  unfold clockFreeRead
  exact (continuous_arenaObs _).comp ((continuous_idxFreeU _).arenaKick continuous_const)

/-- ★★ **The uncoupled reading is the device's coherence**: twice the real part of
`deviceCoherence` of the evolved amplitude, over the norm. The observable the pointer is coupled
to is the quantity the free-chain clock theorems are stated in. -/
theorem clockFreeRead_deviceRay (J μ₀ μ₁ : ℝ) {Ψ : (ZMod (M + 1) × Fin 2) × Fin 2 → ℂ}
    (hΨ : Ψ ≠ 0) (s : ℝ) :
    clockFreeRead J μ₀ μ₁ (deviceRay Ψ hΨ) s
      = 2 * (deviceCoherence (deviceProp J μ₀ μ₁ s *ᵥ Ψ)).re / (deviceNorm Ψ).re := by
  rw [clockFreeRead, deviceRay, arenaObs_levelSwap_kick_mk, idxFreeU_deviceHam_val,
    norm_sq_toLp_device, deviceCoherence]

variable {f : ℝ → ℝ} (J μ₀ μ₁ g : ℝ) (hf : Function.Periodic f 1)

/-- On a fibre where the profile vanishes the reading is the uncoupled one. -/
theorem clockRead_of_lift_eq_zero {φ : AddCircle (1 : ℝ)} (h0 : hf.lift φ = 0)
    (p : GenArena ((ZMod (M + 1) × Fin 2) × Fin 2)) (s : ℝ) :
    clockRead J μ₀ μ₁ g hf φ p s = clockFreeRead J μ₀ μ₁ p s := by
  rw [clockRead, clockFreeRead, clockCarrierU, idxCarrierU_of_lift_eq_zero _ _ hf h0]

/-- ★ **Back-reaction on the reading**: on the fibre `θ₂ = φ` the reading is within
`2 |s| |g f(φ)|` of the uncoupled one. -/
theorem abs_clockRead_sub_free_le (φ : AddCircle (1 : ℝ))
    (p : GenArena ((ZMod (M + 1) × Fin 2) × Fin 2)) (s : ℝ) :
    |clockRead J μ₀ μ₁ g hf φ p s - clockFreeRead J μ₀ μ₁ p s|
      ≤ 2 * (|s| * (|hf.lift φ| * |g|)) := by
  have h := abs_arenaObs_idxCarrierU_sub_le (deviceHam_isHermitian (L := M + 1) J μ₀ μ₁)
    (clockB_isHermitian g) hf φ (levelSwap (ZMod (M + 1) × Fin 2)) p s
  have h1 := norm_levelSwap_le (n := ZMod (M + 1) × Fin 2)
  have h2 := norm_clockB_le (M := M) g
  unfold clockRead clockFreeRead clockCarrierU
  refine h.trans ?_
  calc 2 * ‖levelSwap (ZMod (M + 1) × Fin 2)‖ * (|s| * (|hf.lift φ| * ‖clockB M g‖))
      ≤ 2 * 1 * (|s| * (|hf.lift φ| * |g|)) := by gcongr
    _ = 2 * (|s| * (|hf.lift φ| * |g|)) := by ring

/-- ★★ **The pointer follows the uncoupled reading**, on every fibre: its displacement is within
`2 |f'(θ₂)| g² |f(θ₂)| t²` of `−2 g f'(θ₂)` times the accumulated uncoupled reading. -/
theorem abs_clockPointerShift_sub_free_le (φ : AddCircle (1 : ℝ))
    (p : GenArena ((ZMod (M + 1) × Fin 2) × Fin 2)) {t : ℝ} (ht : 0 ≤ t) :
    |clockPointerShift J μ₀ μ₁ g hf φ p t
        - -(2 * g) * hf.deriv_periodic.lift φ * ∫ s in (0 : ℝ)..t, clockFreeRead J μ₀ μ₁ p s|
      ≤ 2 * |hf.deriv_periodic.lift φ| * (g ^ 2 * |hf.lift φ| * t ^ 2) := by
  have h := abs_idxPointerShift_sub_le (deviceHam_isHermitian (L := M + 1) J μ₀ μ₁)
    (clockB_isHermitian g) hf φ p ht
  have hB : ∀ s, arenaObs (clockB M g)
      (arenaKick (idxFreeU (deviceHam_isHermitian J μ₀ μ₁) s) p)
      = g * clockFreeRead J μ₀ μ₁ p s := fun s =>
    arenaObs_real_smul g (levelSwap (ZMod (M + 1) × Fin 2))
      (arenaKick (idxFreeU (deviceHam_isHermitian J μ₀ μ₁) s) p)
  have e : -2 * hf.deriv_periodic.lift φ
        * (∫ s in (0 : ℝ)..t, arenaObs (clockB M g)
          (arenaKick (idxFreeU (deviceHam_isHermitian J μ₀ μ₁) s) p))
      = -(2 * g) * hf.deriv_periodic.lift φ
        * ∫ s in (0 : ℝ)..t, clockFreeRead J μ₀ μ₁ p s := by
    simp only [hB]
    rw [intervalIntegral.integral_const_mul]
    ring
  rw [idxPointerShift_clock, e] at h
  have h2 := norm_clockB_le (M := M) g
  refine h.trans (mul_le_mul_of_nonneg_left ?_ (by positivity))
  refine mul_le_mul_of_nonneg_right ?_ (sq_nonneg t)
  calc ‖clockB M g‖ * (|hf.lift φ| * ‖clockB M g‖) ≤ |g| * (|hf.lift φ| * |g|) := by gcongr
    _ = g ^ 2 * |hf.lift φ| := by
      rw [← sq_abs g]
      ring

end Law

/-! ### The pointer against the hand -/

section Device

variable {M : ℕ}

/-- ★★ **The accumulated uncoupled reading against the ideal hand.** If the device's coherence
stays within `|s| ε` of a coherence `C₀` turning at the rate `R`, the accumulated reading is
within `ε t² / ‖Ψ₀‖²` of `2/‖Ψ₀‖²` times the hand. The drift `ε` is the localisation term: zero
for one mode, `c D` for the packet of `dirac_device`. -/
theorem abs_integral_clockFreeRead_sub_le (J μ₀ μ₁ : ℝ)
    {Ψ₀ : (ZMod (M + 1) × Fin 2) × Fin 2 → ℂ} (hΨ : Ψ₀ ≠ 0) {R : ℝ} (hR : R ≠ 0) {C₀ : ℂ}
    {ε : ℝ}
    (hdrift : ∀ s : ℝ, ‖deviceCoherence (deviceProp J μ₀ μ₁ s *ᵥ Ψ₀)
        - Complex.exp (Complex.I * (((-R : ℝ) : ℂ) * s)) * C₀‖ ≤ |s| * ε)
    {t : ℝ} (ht : 0 ≤ t) :
    |(∫ s in (0 : ℝ)..t, clockFreeRead J μ₀ μ₁ (deviceRay Ψ₀ hΨ) s)
        - 2 * clockHand R C₀ t / (deviceNorm Ψ₀).re|
      ≤ ε * t ^ 2 / (deviceNorm Ψ₀).re := by
  have hn := deviceNorm_re_pos hΨ
  have hF := continuous_clockFreeRead J μ₀ μ₁ (deviceRay Ψ₀ hΨ)
  have hQ : Continuous fun s => 2 * clockQuad R C₀ s / (deviceNorm Ψ₀).re := by
    have := continuous_clockQuad R C₀
    fun_prop
  have hI : ∫ s in (0 : ℝ)..t, 2 * clockQuad R C₀ s / (deviceNorm Ψ₀).re
      = 2 * clockHand R C₀ t / (deviceNorm Ψ₀).re := by
    rw [intervalIntegral.integral_div, intervalIntegral.integral_const_mul,
      integral_clockQuad hR]
  rw [← hI, ← intervalIntegral.integral_sub (hF.intervalIntegrable 0 t)
    (hQ.intervalIntegrable 0 t)]
  have hc : Continuous fun s : ℝ => 2 * (s * ε) / (deviceNorm Ψ₀).re := by fun_prop
  refine (intervalIntegral.abs_integral_le_integral_abs ht).trans ?_
  refine (intervalIntegral.integral_mono_on ht ((hF.sub hQ).abs.intervalIntegrable 0 t)
    (hc.intervalIntegrable 0 t) fun s hs => ?_).trans_eq ?_
  · have h := (Complex.abs_re_le_norm _).trans (hdrift s)
    rw [Complex.sub_re, re_exp_mul_eq_clockQuad, abs_of_nonneg hs.1] at h
    change |clockFreeRead J μ₀ μ₁ (deviceRay Ψ₀ hΨ) s
      - 2 * clockQuad R C₀ s / (deviceNorm Ψ₀).re| ≤ _
    rw [clockFreeRead_deviceRay, ← sub_div, ← mul_sub, abs_div, abs_mul, abs_two, abs_of_pos hn]
    gcongr
  · rw [intervalIntegral.integral_div, intervalIntegral.integral_const_mul,
      intervalIntegral.integral_mul_const, integral_id]
    ring

/-- A device amplitude of unit norm is not zero. -/
theorem ne_zero_of_deviceNorm_eq_one {Ψ : (ZMod (M + 1) × Fin 2) × Fin 2 → ℂ}
    (h : deviceNorm Ψ = 1) : Ψ ≠ 0 := by
  intro h0
  rw [h0] at h
  simp [deviceNorm] at h

/-- ★ **One mode reads the quadrature exactly**: for a device in a single momentum mode the
uncoupled reading is `2/‖Ψ₀‖²` times the quadrature at the level splitting of that momentum. -/
theorem clockFreeRead_single (J μ₀ μ₁ : ℝ) (m : ℤ) (β : ℤ → ℂ)
    (hΨ : devicePacket (L := M + 1) J μ₀ μ₁ {m} β 0 ≠ 0) (s : ℝ) :
    clockFreeRead J μ₀ μ₁ (deviceRay _ hΨ) s
      = 2 * clockQuad (levelClockRate μ₀ μ₁ (2 * J * Real.sin (angleZ (M + 1) m)))
          (deviceCoherence (devicePacket (L := M + 1) J μ₀ μ₁ {m} β 0)) s
        / (deviceNorm (devicePacket (L := M + 1) J μ₀ μ₁ {m} β 0)).re := by
  rw [clockFreeRead_deviceRay, deviceCoherence_single, re_exp_mul_eq_clockQuad]

variable {f : ℝ → ℝ} (J μ₀ μ₁ g : ℝ) (hf : Function.Periodic f 1)

/-- ★★★ **The clock law for the pointer.** On every fibre, for a device whose coherence stays
within `|s| ε` of `e^{−iRs} C₀`, the pointer's displacement under the joint flow is within

`2 |f'(θ₂)| (g² |f(θ₂)| t² + |g| ε t² / ‖Ψ₀‖²)`

of `−4 g f'(θ₂) clockHand R C₀ t / ‖Ψ₀‖²`. The first error term is the back-reaction of the
pointer's static term on the device, the second the device's localisation. -/
theorem abs_clockPointerShift_sub_hand_le (φ : AddCircle (1 : ℝ))
    {Ψ₀ : (ZMod (M + 1) × Fin 2) × Fin 2 → ℂ} (hΨ : Ψ₀ ≠ 0) {R : ℝ} (hR : R ≠ 0) {C₀ : ℂ}
    {ε : ℝ}
    (hdrift : ∀ s : ℝ, ‖deviceCoherence (deviceProp J μ₀ μ₁ s *ᵥ Ψ₀)
        - Complex.exp (Complex.I * (((-R : ℝ) : ℂ) * s)) * C₀‖ ≤ |s| * ε)
    {t : ℝ} (ht : 0 ≤ t) :
    |clockPointerShift J μ₀ μ₁ g hf φ (deviceRay Ψ₀ hΨ) t
        - -(4 * g) * hf.deriv_periodic.lift φ * clockHand R C₀ t / (deviceNorm Ψ₀).re|
      ≤ 2 * |hf.deriv_periodic.lift φ|
        * (g ^ 2 * |hf.lift φ| * t ^ 2 + |g| * (ε * t ^ 2 / (deviceNorm Ψ₀).re)) := by
  have hA := abs_clockPointerShift_sub_free_le J μ₀ μ₁ g hf φ (deviceRay Ψ₀ hΨ) ht
  have hB := abs_integral_clockFreeRead_sub_le J μ₀ μ₁ hΨ hR hdrift ht
  have h2 : |-(2 * g) * hf.deriv_periodic.lift φ
        * ((∫ s in (0 : ℝ)..t, clockFreeRead J μ₀ μ₁ (deviceRay Ψ₀ hΨ) s)
          - 2 * clockHand R C₀ t / (deviceNorm Ψ₀).re)|
      ≤ 2 * |hf.deriv_periodic.lift φ| * (|g| * (ε * t ^ 2 / (deviceNorm Ψ₀).re)) := by
    rw [abs_mul, abs_mul, abs_neg, abs_mul, abs_two]
    calc 2 * |g| * |hf.deriv_periodic.lift φ|
          * |(∫ s in (0 : ℝ)..t, clockFreeRead J μ₀ μ₁ (deviceRay Ψ₀ hΨ) s)
            - 2 * clockHand R C₀ t / (deviceNorm Ψ₀).re|
        ≤ 2 * |g| * |hf.deriv_periodic.lift φ| * (ε * t ^ 2 / (deviceNorm Ψ₀).re) := by gcongr
      _ = 2 * |hf.deriv_periodic.lift φ| * (|g| * (ε * t ^ 2 / (deviceNorm Ψ₀).re)) := by ring
  have e : clockPointerShift J μ₀ μ₁ g hf φ (deviceRay Ψ₀ hΨ) t
        - -(4 * g) * hf.deriv_periodic.lift φ * clockHand R C₀ t / (deviceNorm Ψ₀).re
      = (clockPointerShift J μ₀ μ₁ g hf φ (deviceRay Ψ₀ hΨ) t
          - -(2 * g) * hf.deriv_periodic.lift φ
            * ∫ s in (0 : ℝ)..t, clockFreeRead J μ₀ μ₁ (deviceRay Ψ₀ hΨ) s)
        + -(2 * g) * hf.deriv_periodic.lift φ
          * ((∫ s in (0 : ℝ)..t, clockFreeRead J μ₀ μ₁ (deviceRay Ψ₀ hΨ) s)
            - 2 * clockHand R C₀ t / (deviceNorm Ψ₀).re) := by
    ring
  rw [e, mul_add]
  exact (abs_add_le _ _).trans (add_le_add hA h2)

/-- ★★ **The pointer's turning points** on a fibre where the profile vanishes, for a device in
one mode: the pointer's rate `−2 g f'(θ₂)` times the reading vanishes exactly when the coherence
has turned to an odd multiple of `π/2`, so the turning points are `π/R` apart in the flow
parameter. They are generated by the joint flow; no schedule is supplied. -/
theorem clockRead_single_eq_zero_iff {φ : AddCircle (1 : ℝ)} (h0 : hf.lift φ = 0) (m : ℤ)
    (β : ℤ → ℂ) (hΨ : devicePacket (L := M + 1) J μ₀ μ₁ {m} β 0 ≠ 0)
    (hC : deviceCoherence (devicePacket (L := M + 1) J μ₀ μ₁ {m} β 0) ≠ 0) (s : ℝ) :
    clockRead J μ₀ μ₁ g hf φ (deviceRay _ hΨ) s = 0
      ↔ ∃ k : ℤ, levelClockRate μ₀ μ₁ (2 * J * Real.sin (angleZ (M + 1) m)) * s
          - Complex.arg (deviceCoherence (devicePacket (L := M + 1) J μ₀ μ₁ {m} β 0))
        = (2 * k + 1) * Real.pi / 2 := by
  have hn := deviceNorm_re_pos hΨ
  rw [clockRead_of_lift_eq_zero J μ₀ μ₁ g hf h0, clockFreeRead_single,
    ← clockQuad_eq_zero_iff _ hC s]
  constructor
  · intro h
    rcases div_eq_zero_iff.mp h with h | h
    · exact (mul_eq_zero.mp h).resolve_left two_ne_zero
    · exact absurd h hn.ne'
  · intro h
    rw [h, mul_zero, zero_div]

/-- ★★ **The exact law** on a fibre where the profile vanishes, for a device in one mode: the
pointer's displacement is `−4 g f'(θ₂)/‖Ψ₀‖²` times the hand at the level splitting of the mode's
momentum, at every flow time and with no error. -/
theorem clockPointerShift_single_eq_hand {φ : AddCircle (1 : ℝ)} (h0 : hf.lift φ = 0) (m : ℤ)
    (β : ℤ → ℂ) (hΨ : devicePacket (L := M + 1) J μ₀ μ₁ {m} β 0 ≠ 0)
    (hR : levelClockRate μ₀ μ₁ (2 * J * Real.sin (angleZ (M + 1) m)) ≠ 0) (t : ℝ) :
    clockPointerShift J μ₀ μ₁ g hf φ (deviceRay _ hΨ) t
      = -(4 * g) * hf.deriv_periodic.lift φ
        * clockHand (levelClockRate μ₀ μ₁ (2 * J * Real.sin (angleZ (M + 1) m)))
          (deviceCoherence (devicePacket (L := M + 1) J μ₀ μ₁ {m} β 0)) t
        / (deviceNorm (devicePacket (L := M + 1) J μ₀ μ₁ {m} β 0)).re := by
  rw [clockPointerShift]
  simp only [clockRead_of_lift_eq_zero J μ₀ μ₁ g hf h0, clockFreeRead_single]
  rw [intervalIntegral.integral_div, intervalIntegral.integral_const_mul,
    integral_clockQuad hR]
  ring

/-- ★ **The pointer returns** on those fibres: its displacement has the period `2π/R`. A pointer
driven by the unrectified quadrature does not accumulate the device's turns. -/
theorem clockPointerShift_single_add_period {φ : AddCircle (1 : ℝ)} (h0 : hf.lift φ = 0)
    (m : ℤ) (β : ℤ → ℂ) (hΨ : devicePacket (L := M + 1) J μ₀ μ₁ {m} β 0 ≠ 0)
    (hR : levelClockRate μ₀ μ₁ (2 * J * Real.sin (angleZ (M + 1) m)) ≠ 0) (t : ℝ) :
    clockPointerShift J μ₀ μ₁ g hf φ (deviceRay _ hΨ)
        (t + 2 * Real.pi / levelClockRate μ₀ μ₁ (2 * J * Real.sin (angleZ (M + 1) m)))
      = clockPointerShift J μ₀ μ₁ g hf φ (deviceRay _ hΨ) t := by
  rw [clockPointerShift_single_eq_hand J μ₀ μ₁ g hf h0 m β hΨ hR,
    clockPointerShift_single_eq_hand J μ₀ μ₁ g hf h0 m β hΨ hR, clockHand_add_period hR]

/-- ★★★ **The pointer against the relativistic clock law, for the device of `dirac_device`.**
For the unit packet of momentum `p₀`, spread `D`, on the ring of `M + 1` sites and circumference
`ℓ`, coupled to the pointer through the level swap with strength `g`:

* the packet is a state of the arena;
* on every fibre the pointer's displacement is within
  `2 |f'(θ₂)| (g² |f(θ₂)| + |g| c D) t²` of `−4 g f'(θ₂)` times the hand at the rate `R`:
  back-reaction plus localisation;
* that rate is dilated: `R/(μ₁ − μ₀)` is within `(μ₁ − μ₀)/E₀` of `√(1 − (v/c)²)`: the finite
  splitting (`dirac_device`, ~~#249~~).

The times are flow times (UA-7): nothing here is yet a reading an observer has. -/
theorem clock_pointer_device {c μ₀ μ₁ ℓ P D p₀ : ℝ} (hc : 0 < c) (h0 : 0 < μ₀)
    (h01 : μ₀ < μ₁) (hℓ : 0 < ℓ) (hp₀ : |p₀| ≤ P) (hD0 : 0 ≤ D) {W : Finset ℤ} {lo : ℤ}
    (hWin : ∀ m ∈ W, lo ≤ m ∧ m + 1 < lo + (M + 1 : ℕ))
    (hWD : ∀ m ∈ W, |2 * Real.pi * m / ℓ - p₀| ≤ D)
    (β : ℤ → ℂ) (hβ : ∑ m ∈ W, ‖β m‖ ^ 2 = 1) (g : ℝ) (hf : Function.Periodic f 1)
    (φ : AddCircle (1 : ℝ)) {t : ℝ} (ht : 0 ≤ t) :
    let J := scaledHop c (ℓ / (M + 1 : ℕ))
    let R := levelClockRate μ₀ μ₁ (2 * J * Real.sin (ℓ / (M + 1 : ℕ) * p₀))
    ∃ hΨ : devicePacket (L := M + 1) J μ₀ μ₁ W β 0 ≠ 0,
      |clockPointerShift J μ₀ μ₁ g hf φ (deviceRay _ hΨ) t
          - -(4 * g) * hf.deriv_periodic.lift φ
            * clockHand R (deviceCoherence (devicePacket (L := M + 1) J μ₀ μ₁ W β 0)) t|
        ≤ 2 * |hf.deriv_periodic.lift φ|
          * (g ^ 2 * |hf.lift φ| * t ^ 2 + |g| * (c * D * t ^ 2))
      ∧ |R / (μ₁ - μ₀)
          - Real.sqrt (1 - (vRel c μ₀ (2 * J * Real.sin (ℓ / (M + 1 : ℕ) * p₀)) / c) ^ 2)|
        ≤ (μ₁ - μ₀) / dispE μ₀ (2 * J * Real.sin (ℓ / (M + 1 : ℕ) * p₀)) := by
  intro J R
  obtain ⟨-, hn0, -, -, hdr0, -, -, -, hdil0⟩ :=
    dirac_device (L := M + 1) hc h0 h01.le hℓ hp₀ hD0 hWin hWD β hβ
  have hn : ∀ s, deviceNorm (devicePacket (L := M + 1) J μ₀ μ₁ W β s) = 1 := hn0
  have hdr : ∀ s : ℝ, ‖deviceCoherence (devicePacket (L := M + 1) J μ₀ μ₁ W β s)
      - Complex.exp (Complex.I * (((-R : ℝ) : ℂ) * s))
        * deviceCoherence (devicePacket (L := M + 1) J μ₀ μ₁ W β 0)‖ ≤ |s| * (c * D) := hdr0
  have hΨ : devicePacket (L := M + 1) J μ₀ μ₁ W β 0 ≠ 0 := ne_zero_of_deviceNorm_eq_one (hn 0)
  have hR : R ≠ 0 := (levelClockRate_pos h0 h01 _).ne'
  have h := abs_clockPointerShift_sub_hand_le J μ₀ μ₁ g hf φ hΨ hR
    (C₀ := deviceCoherence (devicePacket (L := M + 1) J μ₀ μ₁ W β 0)) (ε := c * D)
    (fun s => by rw [deviceProp_devicePacket]; exact hdr s) ht
  rw [hn 0, Complex.one_re, div_one, div_one] at h
  exact ⟨hΨ, h, hdil0 h01⟩

end Device

