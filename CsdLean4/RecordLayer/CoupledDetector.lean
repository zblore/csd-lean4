public import CsdLean4.RecordLayer.TransportedClock
public import CsdLean4.Mathlib.Analysis.ODE.LipschitzFlow

/-!
# Detectors generated by a coupling, with back-reaction on the device

**Category:** 7-SigmaLayer (the record layer). BACKLOG #251, for the control candidate (A). The
declarations live in `CSD.RecordLayer.Coupled`, since several names (`detFlow`) are taken.

#241's test detectors integrate the device's occupancy and are never read back, so the device is
not disturbed (`TransportedClock.lean`, honest scope). Here the detectors are **generated** by a
coupling, and the device feels them.

## The coupling

The device has position `x` and momentum `p`, mass `m`. Detector `j` (site `j`, the cell
`[j, j + 1]`) has a readout `ζ_j` and its conjugate `η_j`. The Hamiltonian is

`H = p²/(2m) + g Σ_j χ(x − j) η_j`,

with a smooth profile `χ` supported in `[0, 1]`, `0 ≤ χ ≤ 1` (`DetProfile`). Hamilton's equations:
`ẋ = p/m`, `ṗ = −g Σ_j χ'(x − j) η_j` (**the kick**), `ζ̇_j = g χ(x − j)` (**the register
advances**), `η̇_j = 0`. So `η` is conserved, and each preparation fixes it; the flow is on
`(x, p, ζ)` with `η` a parameter.

## What is proved

* `DetProfile` (`continuous`, `Kχ_nonneg`, `Kd_nonneg`, `abs_sub_le_one`, `mass`); `force`,
  `detField` (the field of Hamilton's equations), `detHam`;
  ★★ `hasDerivAt_detHam_mom`, `hasDerivAt_detHam_pos` (**the field is `(∂H/∂p, −∂H/∂x, g χ)`**);
  ★★ `lipschitz_detField` (globally Lipschitz), `detFlow` (its flow, `LipschitzWith.odeFlow`),
  `measurable_detFlow`, `detFlow_zero`, `detFlow_add`;
* the equations along the flow: `hasDerivAt_detFlow`, `hasDerivAt_pos`, `hasDerivAt_mom`,
  `hasDerivAt_reg`, `continuous_pos`, `continuous_mom`;
  ★★★ `detHam_flow` (**the energy is conserved**);
* **the disturbance bound** (`S = Σ_j |η_j|`, the registers' conjugate spread):
  ★★★ `abs_mom_sq_sub_le` (**`|p(t)² − p₀²| ≤ 2 m g S` at every time** — it does not grow with
  time), ★★ `mom_pos` (the device never turns back when `p₀² > 2 m g S`), ★★★ `mom_mem_Icc`
  (**`√(p₀² − 2mgS) ≤ p(t) ≤ √(p₀² + 2mgS)`**), ★★ `pos_ge`, `pos_le` (the position between the two
  extreme uniform motions); `momLo`, `momHi`, `momLo_pos`, `momHi_pos`, `momLo_le_momHi`;
* `etaSpread`, `etaSpread_nonneg`;
* the register: `continuous_regRate`; ★★ `reg_eq_of_before` (**nothing is written before the device
  can arrive**),
  ★★★ `reg_ge_of_after` (**after the device has crossed, the register is at least
  `g m A / √(p₀² + 2mgS)`**, `A = ∫₀¹ χ`);
* `coupledEvolve`, `coupledRead`, `measurable_coupledRead`; ★★★ `coupledPassageWrite` — **the
  passage through site `k` as an `ActualOccurrence` of the
  generated flow**, with threshold `0 < θ ≤ g m A / √(p₀² + 2mgS)`: not written before
  `(k − x₀)/(p_hi/m)`, written from `(k + 1 − x₀)/(p_lo/m)` on.

## Honest scope

* **`η` is a parameter of each preparation**, not a coordinate of the arena. It is conserved by the
  flow, so this is the full dynamics restricted to a level set of `η`. The arena is `(x, p, ζ)`.
* ⚠️ **Measure preservation (Liouville) of the coupled flow is not proved here.** It needs a
  volume-preservation theorem for nonlinear Lipschitz flows, which the corpus does not have in
  general (`FlowDerivative.lean` has the flat Liouville theorem for 2-forms). Priced as #291.
* The hand clock and the memory of `TransportedClock.lean` are dropped: the passage does not
  involve them.
* With `η = 0` the bound is zero and the device is undisturbed, recovering #242's test detectors.

## References

`TransportedClock.lean` (`passageRead`, `passageWrite`, #242); `MovingClock.lean` (`movingFlow`);
`Mathlib/Analysis/ODE/LipschitzFlow.lean` (`LipschitzWith.odeFlow`, `hasDerivAt_odeFlow`,
`odeFlow_add`, `measurable_odeFlow`); `RecordOccurrence.lean` (`ActualOccurrence`,
`IsRecordWrite`); `specs/BACKLOG.md` #251, #242, #241, #195; `specs/future-work.md`.
-/

@[expose] public section

open MeasureTheory Set

noncomputable section

namespace CSD.RecordLayer.Coupled

open CSD.SigmaLayer

/-- **A detector profile**: a `C¹` bump with Lipschitz derivative, supported in `[0, 1]`, between
`0` and `1`, of positive mass. -/
structure DetProfile where
  /-- The profile. -/
  χ : ℝ → ℝ
  /-- Its derivative. -/
  dχ : ℝ → ℝ
  hasDerivAt : ∀ x, HasDerivAt χ (dχ x) x
  /-- A Lipschitz constant of the profile. -/
  Kχ : ℝ
  lip : ∀ a b, |χ a - χ b| ≤ Kχ * |a - b|
  /-- A Lipschitz constant of its derivative. -/
  Kd : ℝ
  lip_d : ∀ a b, |dχ a - dχ b| ≤ Kd * |a - b|
  nonneg : ∀ x, 0 ≤ χ x
  le_one : ∀ x, χ x ≤ 1
  zero_of_le : ∀ x, x ≤ 0 → χ x = 0
  zero_of_ge : ∀ x, 1 ≤ x → χ x = 0

namespace DetProfile

variable (P : DetProfile)

theorem continuous : Continuous P.χ :=
  continuous_iff_continuousAt.2 fun x => (P.hasDerivAt x).continuousAt

theorem Kχ_nonneg : 0 ≤ P.Kχ := by
  have h := P.lip 1 0
  simp only [sub_zero, abs_one, mul_one] at h
  exact (abs_nonneg _).trans h

theorem Kd_nonneg : 0 ≤ P.Kd := by
  have h := P.lip_d 1 0
  simp only [sub_zero, abs_one, mul_one] at h
  exact (abs_nonneg _).trans h

theorem abs_sub_le_one (a b : ℝ) : |P.χ a - P.χ b| ≤ 1 := by
  rw [abs_le]
  constructor <;> linarith [P.nonneg a, P.nonneg b, P.le_one a, P.le_one b]

/-- The profile's mass. -/
def mass : ℝ := ∫ u in (0 : ℝ)..1, P.χ u

end DetProfile

variable {L : ℕ} (P : DetProfile) (m g : ℝ) (η : Fin L → ℝ)

/-- **The coupled arena**: position, momentum, the registers' readouts. -/
abbrev DetState (L : ℕ) : Type := ℝ × ℝ × (Fin L → ℝ)

/-- **The kick**: `−g Σ_j χ'(x − j) η_j`. -/
def force (x : ℝ) : ℝ := -(g * ∑ j : Fin L, P.dχ (x - (j : ℕ)) * η j)

/-- **Hamilton's equations** of `H = p²/(2m) + g Σ_j χ(x − j) η_j`. -/
def detField (z : DetState L) : DetState L :=
  (z.2.1 / m, force P g η z.1, fun j => g * P.χ (z.1 - (j : ℕ)))

/-- **The Hamiltonian.** -/
def detHam (z : DetState L) : ℝ :=
  z.2.1 ^ 2 / (2 * m) + g * ∑ j : Fin L, P.χ (z.1 - (j : ℕ)) * η j

/-- `∂H/∂p = p/m`, the field's first component. -/
theorem hasDerivAt_detHam_mom (hm : m ≠ 0) (x p : ℝ) (ζ : Fin L → ℝ) :
    HasDerivAt (fun q => detHam P m g η (x, q, ζ)) (p / m) p := by
  have h := ((hasDerivAt_pow 2 p).div_const (2 * m)).add_const
    (g * ∑ j : Fin L, P.χ (x - (j : ℕ)) * η j)
  simp only [detHam]
  convert h using 1
  rw [show ((2 : ℕ) : ℝ) * p ^ (2 - 1) = 2 * p by norm_num]
  field_simp

/-- `−∂H/∂x` is the force, the field's second component. -/
theorem hasDerivAt_detHam_pos (x p : ℝ) (ζ : Fin L → ℝ) :
    HasDerivAt (fun y => detHam P m g η (y, p, ζ)) (-force P g η x) x := by
  have hs : HasDerivAt (fun y => ∑ j : Fin L, P.χ (y - (j : ℕ)) * η j)
      (∑ j : Fin L, P.dχ (x - (j : ℕ)) * η j) x :=
    HasDerivAt.fun_sum fun j _ => (((P.hasDerivAt _).comp x
      ((hasDerivAt_id x).sub_const _)).mul_const (η j)).congr_deriv (by simp)
  have h := (hs.const_mul g).const_add (p ^ 2 / (2 * m))
  simpa [detHam, force] using h

variable {m g}

/-- ★★ **The field is globally Lipschitz.** -/
theorem lipschitz_detField (hm : 0 < m) (hg : 0 ≤ g) :
    LipschitzWith (Real.toNNReal (1 / m + g * (∑ j, |η j|) * P.Kd + g * P.Kχ))
      (detField P m g η) := by
  refine LipschitzWith.of_dist_le' fun z w => ?_
  have hS : 0 ≤ ∑ j, |η j| := Finset.sum_nonneg fun j _ => abs_nonneg _
  have hd1 : |z.1 - w.1| ≤ dist z w := by
    rw [← Real.dist_eq, Prod.dist_eq]
    exact le_max_left _ _
  have hd2 : |z.2.1 - w.2.1| ≤ dist z w := by
    rw [← Real.dist_eq, Prod.dist_eq (x := z), Prod.dist_eq (x := z.2)]
    exact (le_max_left _ _).trans (le_max_right _ _)
  have hdist : 0 ≤ dist z w := dist_nonneg
  have hA : 0 ≤ g * (∑ j, |η j|) * P.Kd * dist z w :=
    mul_nonneg (mul_nonneg (mul_nonneg hg hS) P.Kd_nonneg) hdist
  have hB : 0 ≤ g * P.Kχ * dist z w := mul_nonneg (mul_nonneg hg P.Kχ_nonneg) hdist
  have hC : 0 ≤ 1 / m * dist z w := mul_nonneg (by positivity) hdist
  have e1 : dist (z.2.1 / m) (w.2.1 / m) ≤ 1 / m * dist z w := by
    rw [Real.dist_eq, ← sub_div, abs_div, abs_of_pos hm, div_eq_mul_inv, mul_comm, one_div]
    exact mul_le_mul_of_nonneg_left hd2 (by positivity)
  have e2 : dist (force P g η z.1) (force P g η w.1) ≤ g * (∑ j, |η j|) * P.Kd * dist z w := by
    rw [Real.dist_eq, force, force, neg_sub_neg, ← mul_sub, ← Finset.sum_sub_distrib, abs_mul,
      abs_of_nonneg hg, mul_assoc, mul_assoc]
    refine mul_le_mul_of_nonneg_left ?_ hg
    calc |∑ j : Fin L, (P.dχ (w.1 - (j : ℕ)) * η j - P.dχ (z.1 - (j : ℕ)) * η j)|
        ≤ ∑ j : Fin L, |P.dχ (w.1 - (j : ℕ)) * η j - P.dχ (z.1 - (j : ℕ)) * η j| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ j : Fin L, |η j| * (P.Kd * dist z w) := by
          refine Finset.sum_le_sum fun j _ => ?_
          rw [← sub_mul, abs_mul, mul_comm]
          refine mul_le_mul_of_nonneg_left ?_ (abs_nonneg _)
          refine (P.lip_d _ _).trans (mul_le_mul_of_nonneg_left ?_ P.Kd_nonneg)
          rw [sub_sub_sub_cancel_right, abs_sub_comm]
          exact hd1
      _ = (∑ j : Fin L, |η j|) * (P.Kd * dist z w) := by rw [Finset.sum_mul]
  have e3 : dist (fun j : Fin L => g * P.χ (z.1 - (j : ℕ))) (fun j => g * P.χ (w.1 - (j : ℕ)))
      ≤ g * P.Kχ * dist z w := by
    refine (dist_pi_le_iff hB).2 fun j => ?_
    rw [Real.dist_eq, ← mul_sub, abs_mul, abs_of_nonneg hg, mul_assoc]
    refine mul_le_mul_of_nonneg_left ((P.lip _ _).trans ?_) hg
    refine mul_le_mul_of_nonneg_left ?_ P.Kχ_nonneg
    rw [sub_sub_sub_cancel_right]
    exact hd1
  rw [Prod.dist_eq, Prod.dist_eq]
  show max (dist (z.2.1 / m) (w.2.1 / m)) (max (dist (force P g η z.1) (force P g η w.1))
    (dist (fun j : Fin L => g * P.χ (z.1 - (j : ℕ))) (fun j => g * P.χ (w.1 - (j : ℕ)))))
      ≤ (1 / m + g * (∑ j, |η j|) * P.Kd + g * P.Kχ) * dist z w
  refine max_le ?_ (max_le ?_ ?_) <;> nlinarith

/-- **The coupled flow.** -/
def detFlow (hm : 0 < m) (hg : 0 ≤ g) (t : ℝ) (z : DetState L) : DetState L :=
  (lipschitz_detField P η hm hg).odeFlow t z

variable (hm : 0 < m) (hg : 0 ≤ g)

theorem measurable_detFlow (t : ℝ) : Measurable (detFlow P η hm hg t) :=
  (lipschitz_detField P η hm hg).measurable_odeFlow t

theorem detFlow_zero (z : DetState L) : detFlow P η hm hg 0 z = z :=
  (lipschitz_detField P η hm hg).odeFlow_zero z

theorem detFlow_add (s t : ℝ) (z : DetState L) :
    detFlow P η hm hg (s + t) z = detFlow P η hm hg t (detFlow P η hm hg s z) :=
  (lipschitz_detField P η hm hg).odeFlow_add s t z

/-! ### Hamilton's equations along the flow -/

theorem hasDerivAt_detFlow (z : DetState L) (t : ℝ) :
    HasDerivAt (fun t => detFlow P η hm hg t z) (detField P m g η (detFlow P η hm hg t z)) t :=
  (lipschitz_detField P η hm hg).hasDerivAt_odeFlow z t

theorem hasDerivAt_pos (z : DetState L) (t : ℝ) :
    HasDerivAt (fun t => (detFlow P η hm hg t z).1) ((detFlow P η hm hg t z).2.1 / m) t :=
  (hasDerivAt_detFlow P η hm hg z t).fst

theorem hasDerivAt_mom (z : DetState L) (t : ℝ) :
    HasDerivAt (fun t => (detFlow P η hm hg t z).2.1)
      (force P g η (detFlow P η hm hg t z).1) t :=
  (hasDerivAt_detFlow P η hm hg z t).snd.fst

theorem hasDerivAt_reg (z : DetState L) (k : Fin L) (t : ℝ) :
    HasDerivAt (fun t => (detFlow P η hm hg t z).2.2 k)
      (g * P.χ ((detFlow P η hm hg t z).1 - (k : ℕ))) t :=
  hasDerivAt_pi.1 (hasDerivAt_detFlow P η hm hg z t).snd.snd k

theorem continuous_pos (z : DetState L) : Continuous fun t => (detFlow P η hm hg t z).1 :=
  continuous_iff_continuousAt.2 fun t => (hasDerivAt_pos P η hm hg z t).continuousAt

theorem continuous_mom (z : DetState L) : Continuous fun t => (detFlow P η hm hg t z).2.1 :=
  continuous_iff_continuousAt.2 fun t => (hasDerivAt_mom P η hm hg z t).continuousAt

/-- ★★★ **The energy is conserved along the coupled flow.** -/
theorem detHam_flow (z : DetState L) (t : ℝ) :
    detHam P m g η (detFlow P η hm hg t z) = detHam P m g η z := by
  have hd : ∀ s, HasDerivAt (fun s => detHam P m g η (detFlow P η hm hg s z)) 0 s := by
    intro s
    set y := detFlow P η hm hg s z
    have hp := hasDerivAt_mom P η hm hg z s
    have hx := hasDerivAt_pos P η hm hg z s
    have h1 : HasDerivAt (fun s => (detFlow P η hm hg s z).2.1 ^ 2 / (2 * m))
        (2 * y.2.1 * force P g η y.1 / (2 * m)) s := by
      have := (hp.pow 2).div_const (2 * m)
      convert this using 1
      ring
    have h2 : HasDerivAt (fun s => ∑ j : Fin L, P.χ ((detFlow P η hm hg s z).1 - (j : ℕ)) * η j)
        (∑ j : Fin L, P.dχ (y.1 - (j : ℕ)) * (y.2.1 / m) * η j) s :=
      HasDerivAt.fun_sum fun j _ =>
        ((P.hasDerivAt _).comp s (hx.sub_const _)).mul_const (η j)
    have h := h1.add (h2.const_mul g)
    have hfun : (fun s => detHam P m g η (detFlow P η hm hg s z)) = fun s =>
        (detFlow P η hm hg s z).2.1 ^ 2 / (2 * m)
          + g * ∑ j : Fin L, P.χ ((detFlow P η hm hg s z).1 - (j : ℕ)) * η j := rfl
    rw [hfun]
    refine h.congr_deriv ?_
    have hsum : ∑ j : Fin L, P.dχ (y.1 - (j : ℕ)) * (y.2.1 / m) * η j
        = y.2.1 / m * ∑ j : Fin L, P.dχ (y.1 - (j : ℕ)) * η j := by
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl fun j _ => by ring
    rw [hsum, force]
    field_simp
    ring
  have := is_const_of_deriv_eq_zero (fun s => (hd s).differentiableAt)
    (fun s => (hd s).deriv) t 0
  simpa [detFlow_zero] using this

/-! ### The disturbance bound -/

/-- `S = Σ_j |η_j|`, the registers' conjugate spread. -/
def etaSpread : ℝ := ∑ j : Fin L, |η j|

theorem etaSpread_nonneg : 0 ≤ etaSpread η := Finset.sum_nonneg fun _ _ => abs_nonneg _

/-- ★★★ **The kick is bounded at every time, uniformly in time**: `|p(t)² − p₀²| ≤ 2 m g S`. -/
theorem abs_mom_sq_sub_le (z : DetState L) (t : ℝ) :
    |(detFlow P η hm hg t z).2.1 ^ 2 - z.2.1 ^ 2| ≤ 2 * m * g * etaSpread η := by
  have hE := detHam_flow P η hm hg z t
  set y := detFlow P η hm hg t z
  simp only [detHam] at hE
  have hsum : |∑ j : Fin L, P.χ (z.1 - (j : ℕ)) * η j - ∑ j : Fin L, P.χ (y.1 - (j : ℕ)) * η j|
      ≤ etaSpread η := by
    rw [← Finset.sum_sub_distrib]
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun j _ => ?_)
    rw [← sub_mul, abs_mul]
    exact mul_le_of_le_one_left (abs_nonneg _) (P.abs_sub_le_one _ _)
  have hkey : y.2.1 ^ 2 - z.2.1 ^ 2 = 2 * m * g * (∑ j : Fin L, P.χ (z.1 - (j : ℕ)) * η j
      - ∑ j : Fin L, P.χ (y.1 - (j : ℕ)) * η j) := by
    field_simp at hE
    linear_combination hE
  rw [hkey, abs_mul, abs_of_nonneg (by positivity : 0 ≤ 2 * m * g)]
  exact mul_le_mul_of_nonneg_left hsum (by positivity)

variable {P η hm hg}

/-- ★★ **The device never turns back** when its kinetic margin exceeds the coupling's reach. -/
theorem mom_pos {z : DetState L} (hp : 0 < z.2.1) (hmargin : 2 * m * g * etaSpread η < z.2.1 ^ 2)
    (t : ℝ) : 0 < (detFlow P η hm hg t z).2.1 := by
  by_contra hc
  push Not at hc
  have hcont := (continuous_mom P η hm hg z).continuousOn (s := uIcc 0 t)
  have hmem : (0 : ℝ) ∈ uIcc ((detFlow P η hm hg 0 z).2.1) ((detFlow P η hm hg t z).2.1) := by
    rw [detFlow_zero]
    exact mem_uIcc.2 (Or.inr ⟨hc, hp.le⟩)
  obtain ⟨s, -, hs⟩ := intermediate_value_uIcc hcont hmem
  have hs' : (detFlow P η hm hg s z).2.1 = 0 := hs
  have h := abs_mom_sq_sub_le P η hm hg z s
  rw [hs'] at h
  have := (abs_le.1 h).1
  nlinarith

/-- ★★★ **The momentum stays in `[√(p₀² − 2mgS), √(p₀² + 2mgS)]`.** -/
theorem mom_mem_Icc {z : DetState L} (hp : 0 < z.2.1)
    (hmargin : 2 * m * g * etaSpread η < z.2.1 ^ 2) (t : ℝ) :
    Real.sqrt (z.2.1 ^ 2 - 2 * m * g * etaSpread η) ≤ (detFlow P η hm hg t z).2.1 ∧
      (detFlow P η hm hg t z).2.1 ≤ Real.sqrt (z.2.1 ^ 2 + 2 * m * g * etaSpread η) := by
  have hpos := mom_pos (P := P) (hm := hm) (hg := hg) hp hmargin t
  have h := abs_le.1 (abs_mom_sq_sub_le P η hm hg z t)
  constructor
  · rw [Real.sqrt_le_left]
    · linarith [h.1]
    · exact hpos.le
  · rw [Real.le_sqrt hpos.le (by nlinarith [etaSpread_nonneg η, sq_nonneg z.2.1, hm.le])]
    linarith [h.2]

/-- `p_lo`, the slowest the device can go. -/
def momLo (p₀ : ℝ) : ℝ := Real.sqrt (p₀ ^ 2 - 2 * m * g * etaSpread η)

/-- `p_hi`, the fastest the device can go. -/
def momHi (p₀ : ℝ) : ℝ := Real.sqrt (p₀ ^ 2 + 2 * m * g * etaSpread η)

/-- ★★ **The position is at least the slowest uniform motion's**, forward in time. -/
theorem pos_ge {z : DetState L} (hp : 0 < z.2.1) (hmargin : 2 * m * g * etaSpread η < z.2.1 ^ 2)
    {t : ℝ} (ht : 0 ≤ t) : z.1 + momLo (m := m) (g := g) (η := η) z.2.1 / m * t
      ≤ (detFlow P η hm hg t z).1 := by
  have hmono : Monotone fun s =>
      (detFlow P η hm hg s z).1 - momLo (m := m) (g := g) (η := η) z.2.1 / m * s :=
    monotone_of_hasDerivAt_nonneg
      (fun s => (hasDerivAt_pos P η hm hg z s).sub ((hasDerivAt_id s).const_mul _)) fun s => by
        have h := (mom_mem_Icc (P := P) (hm := hm) (hg := hg) hp hmargin s).1
        simp only [mul_one, momLo]
        show (0 : ℝ) ≤ _
        linarith [div_le_div_of_nonneg_right h hm.le]
  have := hmono ht
  simp only [detFlow_zero, mul_zero, sub_zero] at this
  linarith

/-- ★★ **The position is at most the fastest uniform motion's**, forward in time. -/
theorem pos_le {z : DetState L} (hp : 0 < z.2.1) (hmargin : 2 * m * g * etaSpread η < z.2.1 ^ 2)
    {t : ℝ} (ht : 0 ≤ t) : (detFlow P η hm hg t z).1
      ≤ z.1 + momHi (m := m) (g := g) (η := η) z.2.1 / m * t := by
  have hmono : Monotone fun s =>
      momHi (m := m) (g := g) (η := η) z.2.1 / m * s - (detFlow P η hm hg s z).1 :=
    monotone_of_hasDerivAt_nonneg
      (fun s => ((hasDerivAt_id s).const_mul _).sub (hasDerivAt_pos P η hm hg z s)) fun s => by
        have h := (mom_mem_Icc (P := P) (hm := hm) (hg := hg) hp hmargin s).2
        simp only [mul_one, momHi]
        show (0 : ℝ) ≤ _
        linarith [div_le_div_of_nonneg_right h hm.le]
  have := hmono ht
  simp only [detFlow_zero, mul_zero, zero_sub] at this
  linarith

theorem momHi_pos (hm : 0 < m) (hg : 0 ≤ g) {p₀ : ℝ} (hp : 0 < p₀) :
    0 < momHi (m := m) (g := g) (η := η) p₀ :=
  Real.sqrt_pos.2 (by
    nlinarith [etaSpread_nonneg η, mul_nonneg (mul_nonneg (by norm_num : (0 : ℝ) ≤ 2) hm.le) hg])

theorem momLo_pos {p₀ : ℝ} (hmargin : 2 * m * g * etaSpread η < p₀ ^ 2) :
    0 < momLo (m := m) (g := g) (η := η) p₀ :=
  Real.sqrt_pos.2 (by linarith)

theorem momLo_le_momHi (hm : 0 < m) (hg : 0 ≤ g) (p₀ : ℝ) :
    momLo (m := m) (g := g) (η := η) p₀ ≤ momHi (m := m) (g := g) (η := η) p₀ :=
  Real.sqrt_le_sqrt (by
    nlinarith [etaSpread_nonneg η, mul_nonneg (mul_nonneg (by norm_num : (0 : ℝ) ≤ 2) hm.le) hg])

/-! ### The register -/

theorem continuous_regRate (z : DetState L) (k : Fin L) :
    Continuous fun s => g * P.χ ((detFlow P η hm hg s z).1 - (k : ℕ)) :=
  continuous_const.mul (P.continuous.comp ((continuous_pos P η hm hg z).sub continuous_const))

/-- ★★ **Nothing is written before the device can arrive.** While even the fastest motion the bound
allows has not reached site `k`, the register at `k` is unchanged. -/
theorem reg_eq_of_before {z : DetState L} (hp : 0 < z.2.1)
    (hmargin : 2 * m * g * etaSpread η < z.2.1 ^ 2) (k : Fin L) {t : ℝ} (ht0 : 0 ≤ t)
    (hb : z.1 + momHi (m := m) (g := g) (η := η) z.2.1 / m * t < (k : ℕ)) :
    (detFlow P η hm hg t z).2.2 k = z.2.2 k := by
  have hint := intervalIntegral.integral_eq_sub_of_hasDerivAt
    (fun s _ => hasDerivAt_reg P η hm hg z k s)
    ((continuous_regRate (P := P) (hm := hm) (hg := hg) z k).intervalIntegrable 0 t)
  have hzero : ∫ s in (0 : ℝ)..t, g * P.χ ((detFlow P η hm hg s z).1 - (k : ℕ)) = 0 := by
    rw [intervalIntegral.integral_congr (g := fun _ => (0 : ℝ)) ?_, intervalIntegral.integral_zero]
    intro s hs
    rw [uIcc_of_le ht0] at hs
    have h1 := pos_le (P := P) (hm := hm) (hg := hg) hp hmargin hs.1
    have h2 : momHi (m := m) (g := g) (η := η) z.2.1 / m * s
        ≤ momHi (m := m) (g := g) (η := η) z.2.1 / m * t :=
      mul_le_mul_of_nonneg_left hs.2 (div_nonneg (Real.sqrt_nonneg _) hm.le)
    show g * P.χ ((detFlow P η hm hg s z).1 - (k : ℕ)) = 0
    rw [P.zero_of_le _ (by linarith), mul_zero]
  rw [hzero, detFlow_zero] at hint
  linarith

/-- ★★★ **After the device has crossed site `k`, the register has advanced by at least
`g m A / p_hi`.** The comparison: `ζ̇_k = g χ(x − k) ≥ (g m / p_hi) · d/dt ∫_k^x χ(u − k) du`,
because `ẋ = p/m ≤ p_hi/m`. -/
theorem reg_ge_of_after {z : DetState L} (hp : 0 < z.2.1)
    (hmargin : 2 * m * g * etaSpread η < z.2.1 ^ 2) (k : Fin L) (hx : z.1 ≤ (k : ℕ)) {t : ℝ}
    (ht0 : 0 ≤ t)
    (ha : ((k : ℕ) : ℝ) + 1 ≤ z.1 + momLo (m := m) (g := g) (η := η) z.2.1 / m * t) :
    z.2.2 k + g * m * P.mass / momHi (m := m) (g := g) (η := η) z.2.1
      ≤ (detFlow P η hm hg t z).2.2 k := by
  set ph := momHi (m := m) (g := g) (η := η) z.2.1 with hph
  have hph0 : 0 < ph := momHi_pos (η := η) hm hg hp
  have hcχ : Continuous fun u => P.χ (u - (k : ℕ)) :=
    P.continuous.comp (continuous_id.sub continuous_const)
  set G : ℝ → ℝ := fun y => ∫ u in ((k : ℕ) : ℝ)..y, P.χ (u - (k : ℕ)) with hGdef
  have hG : ∀ y, HasDerivAt G (P.χ (y - (k : ℕ))) y := fun y =>
    intervalIntegral.integral_hasDerivAt_right (hcχ.intervalIntegrable _ _)
      (hcχ.stronglyMeasurableAtFilter _ _) hcχ.continuousAt
  have hGx : ∀ s, HasDerivAt (fun s => G (detFlow P η hm hg s z).1)
      (P.χ ((detFlow P η hm hg s z).1 - (k : ℕ)) * ((detFlow P η hm hg s z).2.1 / m)) s :=
    fun s => (hG _).comp s (hasDerivAt_pos P η hm hg z s)
  have hmono : Monotone fun s => (detFlow P η hm hg s z).2.2 k
      - g * m / ph * G (detFlow P η hm hg s z).1 :=
    monotone_of_hasDerivAt_nonneg
      (fun s => (hasDerivAt_reg P η hm hg z k s).sub ((hGx s).const_mul (g * m / ph))) fun s => by
        have hq := (mom_mem_Icc (P := P) (hm := hm) (hg := hg) hp hmargin s)
        have hχ0 := P.nonneg ((detFlow P η hm hg s z).1 - (k : ℕ))
        show (0 : ℝ) ≤ g * P.χ ((detFlow P η hm hg s z).1 - (k : ℕ))
          - g * m / ph * (P.χ ((detFlow P η hm hg s z).1 - (k : ℕ))
            * ((detFlow P η hm hg s z).2.1 / m))
        have hle : (detFlow P η hm hg s z).2.1 / ph ≤ 1 := (div_le_one hph0).2 hq.2
        have hrw : g * P.χ ((detFlow P η hm hg s z).1 - (k : ℕ))
            - g * m / ph * (P.χ ((detFlow P η hm hg s z).1 - (k : ℕ))
              * ((detFlow P η hm hg s z).2.1 / m))
            = g * P.χ ((detFlow P η hm hg s z).1 - (k : ℕ))
              * (1 - (detFlow P η hm hg s z).2.1 / ph) := by
          field_simp
        rw [hrw]
        exact mul_nonneg (mul_nonneg hg hχ0) (by linarith)
  have h0 := hmono ht0
  simp only [detFlow_zero] at h0
  have hG0 : G z.1 = 0 := by
    show ∫ u in ((k : ℕ) : ℝ)..z.1, P.χ (u - (k : ℕ)) = 0
    rw [intervalIntegral.integral_congr (g := fun _ => (0 : ℝ)) ?_, intervalIntegral.integral_zero]
    intro u hu
    rw [uIcc_of_ge hx] at hu
    exact P.zero_of_le _ (by linarith [hu.2])
  have hxt := pos_ge (P := P) (hm := hm) (hg := hg) hp hmargin ht0
  have hGt : G (detFlow P η hm hg t z).1 = P.mass := by
    show ∫ u in ((k : ℕ) : ℝ)..(detFlow P η hm hg t z).1, P.χ (u - (k : ℕ)) = P.mass
    rw [← intervalIntegral.integral_add_adjacent_intervals (b := ((k : ℕ) : ℝ) + 1)
      (hcχ.intervalIntegrable _ _) (hcχ.intervalIntegrable _ _)]
    have h2 : ∫ u in ((k : ℕ) : ℝ) + 1..(detFlow P η hm hg t z).1, P.χ (u - (k : ℕ)) = 0 := by
      rw [intervalIntegral.integral_congr (g := fun _ => (0 : ℝ)) ?_,
        intervalIntegral.integral_zero]
      intro u hu
      rw [uIcc_of_le (by linarith)] at hu
      exact P.zero_of_ge _ (by linarith [hu.1])
    rw [h2, add_zero, intervalIntegral.integral_comp_sub_right, sub_self, add_sub_cancel_left]
    rfl
  rw [hG0, hGt, mul_zero, sub_zero] at h0
  have : g * m / ph * P.mass = g * m * P.mass / ph := by ring
  linarith

/-! ### The passage, written by the generated flow -/

/-- **The coupled two-time evolution.** -/
def coupledEvolve (s t : OnticTime) : DetState L → DetState L := detFlow P η hm hg (t - s)

/-- **A detector's readout**: whether its register has reached `θ`. -/
def coupledRead (θ : ℝ) (k : Fin L) (z : DetState L) : ℕ := if θ ≤ z.2.2 k then 1 else 0

theorem measurable_coupledRead (θ : ℝ) (k : Fin L) : Measurable (coupledRead (L := L) θ k) := by
  refine Measurable.ite ?_ measurable_const measurable_const
  exact measurableSet_le measurable_const
    ((measurable_pi_apply k).comp (measurable_snd.comp measurable_snd))

/-- ★★★ **The device's passage through site `k`, written by the generated flow** (#251's
acceptance): the detector at `k`, prepared at zero with a threshold `0 < θ ≤ g m A / p_hi`, is not
written before `(k − x₀)/(p_hi/m)` and is written from `(k + 1 − x₀)/(p_lo/m)` on, while the
device is kicked by every detector, its momentum within `[p_lo, p_hi]` (`mom_mem_Icc`). -/
def coupledPassageWrite (θ : ℝ) (hθ0 : 0 < θ) (k : Fin L) (x₀ p₀ : ℝ) (det₀ : Fin L → ℝ)
    (hdet : det₀ k = 0) (hp : 0 < p₀) (hmargin : 2 * m * g * etaSpread η < p₀ ^ 2)
    (hx : x₀ < (k : ℕ)) (hθ : θ ≤ g * m * P.mass / momHi (m := m) (g := g) (η := η) p₀) :
    ActualOccurrence (DetState L) ℕ L where
  evolve := coupledEvolve (P := P) (η := η) (hm := hm) (hg := hg)
  evolve_self := fun t => funext fun z => by
    simp only [coupledEvolve, sub_self, detFlow_zero, id]
  evolve_comp := fun s t u => funext fun z => by
    simp only [coupledEvolve, Function.comp]
    rw [← detFlow_add]
    congr 1
    ring
  measurable_evolve := fun s t => measurable_detFlow P η hm hg (t - s)
  readout := coupledRead θ k
  measurable_readout := measurable_coupledRead θ k
  ready := {z | z.2.2 k = 0}
  measurableSet_ready := measurableSet_eq_fun
    ((measurable_pi_apply k).comp (measurable_snd.comp measurable_snd)) measurable_const
  prep := (x₀, p₀, det₀)
  prep_mem := hdet
  site := {k}
  start := 0
  value := 1
  writeStart := (((k : ℕ) : ℝ) - x₀) / (momHi (m := m) (g := g) (η := η) p₀ / m)
  writeEnd := (((k : ℕ) : ℝ) + 1 - x₀) / (momLo (m := m) (g := g) (η := η) p₀ / m)
  window := 1
  isWrite :=
    have hhi : 0 < momHi (m := m) (g := g) (η := η) p₀ / m := div_pos (momHi_pos hm hg hp) hm
    have hlo : 0 < momLo (m := m) (g := g) (η := η) p₀ / m := div_pos (momLo_pos hmargin) hm
    have hlh : momLo (m := m) (g := g) (η := η) p₀ / m
        ≤ momHi (m := m) (g := g) (η := η) p₀ / m :=
      div_le_div_of_nonneg_right (momLo_le_momHi hm hg p₀) hm.le
    { start_le := div_nonneg (by linarith) hhi.le
      interval := by
        rw [div_le_div_iff₀ hhi hlo]
        nlinarith
      window_nonneg := zero_le_one
      before := fun t ht0 ht => by
        have hb : x₀ + momHi (m := m) (g := g) (η := η) p₀ / m * t < (k : ℕ) := by
          rw [lt_div_iff₀ hhi] at ht
          linarith
        have hr := reg_eq_of_before (P := P) (hm := hm) (hg := hg) (z := (x₀, p₀, det₀)) hp
          hmargin k (by simpa using ht0) hb
        show coupledRead θ k (detFlow P η hm hg (t - 0) (x₀, p₀, det₀)) ≠ 1
        rw [sub_zero, coupledRead, hr]
        show (if θ ≤ det₀ k then 1 else 0) ≠ 1
        rw [hdet, ite_eq_right (by linarith)]
        decide
      holds := fun t ht₁ _ => by
        have hc : ((k : ℕ) : ℝ) + 1 ≤ x₀ + momLo (m := m) (g := g) (η := η) p₀ / m * t := by
          rw [div_le_iff₀ hlo] at ht₁
          linarith
        have ht0 : 0 ≤ t := (div_nonneg (by linarith) hlo.le).trans ht₁
        have hr := reg_ge_of_after (P := P) (hm := hm) (hg := hg) (z := (x₀, p₀, det₀)) hp
          hmargin k hx.le ht0 hc
        show coupledRead θ k (detFlow P η hm hg (t - 0) (x₀, p₀, det₀)) = 1
        rw [sub_zero, coupledRead, ite_eq_left]
        simp only [hdet, zero_add] at hr
        linarith }

end CSD.RecordLayer.Coupled
